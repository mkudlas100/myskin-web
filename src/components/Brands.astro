---
// Kosmetika, se kterou pracuji: PHYT'S, NOON, G.M. Collin jako záložky. Bez JS se ukážou všechny.
import { Image } from 'astro:assets';
import { cz } from '../lib/cz';
import logoPhyts from '../assets/img/logo-phyts.png';
import logoNoon from '../assets/img/logo-noon.png';
import logoCollin from '../assets/img/logo-gm-collin.png';
import imgPhyts from '../assets/img/znacka-phyts.png';
import imgNoon from '../assets/img/znacka-noon.webp';
import imgCollin from '../assets/img/znacka-gm-collin.png';

const brands = [
  { id: 'noon', name: 'NOON Aesthetics', logo: logoNoon, img: imgNoon, imgAlt: 'Přípravek NOON Aesthetics', href: '/kura-chemicky-peeling', link: 'Chemický peeling NOON',
    sub: 'Izraelská profesionální dermokosmetika',
    text: 'Patentovaná technologie DermShield™ umožňuje používat vysoké koncentrace účinných látek bez podráždění. Péče je účinná, a přitom šetrná i k citlivé pleti.',
    points: ['Vysoké koncentrace účinných látek', 'Izraelská preciznost a inovace', 'Bez parfemace, parabenů a zbytečné chemie'] },
  { id: 'phyts', name: 'PHYT’S', logo: logoPhyts, img: imgPhyts, imgAlt: 'Sérum PHYT’S', href: '/kosmeticke-osetreni', link: 'Ošetření s kosmetikou PHYT’S',
    sub: 'Francouzská přírodní kosmetika pro profesionální péči',
    text: 'Certifikovaná BIO kosmetika PHYT’S splňuje mé vysoké nároky na přírodní přípravky. Patří mezi vedoucí francouzské značky profesionální péče o pleť: pracuje s ní více než 3 000 kosmetických salonů ve 47 zemích světa.',
    points: ['Certifikované BIO složení z rostlinných extraktů a esenciálních olejů', 'Francouzská tradice a odbornost', 'Bez parabenů, syntetických barviv a zbytečné chemie'] },
  { id: 'collin', name: 'G.M. Collin', logo: logoCollin, img: imgCollin, imgAlt: 'Přípravky G.M. Collin', href: '/pece-collagen', link: 'Liftingový rituál G.M. Collin',
    sub: 'Kanadská dermokosmetická značka od roku 1957',
    text: 'G.M. Collin spojuje přírodní ingredience s moderními biotechnologiemi. Přípravky vznikají v laboratořích v Montrealu ve spolupráci s dermatology a vědci.',
    points: ['Intenzivní hydratace a regenerace pleti', 'Peptidy, probiotika, kyselina hyaluronová', 'Profesionální péče s dlouhodobým výsledkem'] },
];
---
<section class="sec brands" aria-labelledby="h-brands" data-tabs>
  <div class="wrap">
    <div class="brands__head">
      <h2 id="h-brands" class="h2 split">Kosmetika, se kterou pracuji</h2>
      <div class="brands__tabs" role="tablist" aria-label="Značky kosmetiky">
        {brands.map((b, i) => (
          <button type="button" role="tab" id={`tab-${b.id}`} aria-controls={`panel-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <Image src={b.logo} widths={[240, 480]} sizes="160px" alt={b.name} />
          </button>
        ))}
      </div>
    </div>
    {brands.map((b, i) => (
      <div class:list={['brands__panel', i === 0 && 'on']} role="tabpanel" id={`panel-${b.id}`} aria-labelledby={`tab-${b.id}`}>
        <div class="brands__img"><Image src={b.img} widths={[360, 600, 900]} sizes="(max-width: 860px) 80vw, 34vw" alt={b.imgAlt} /></div>
        <div class="brands__text">
          <h3>{b.name}</h3>
          <p class="brands__sub">{cz(b.sub)}</p>
          <p>{cz(b.text)}</p>
          <ul>{b.points.map((p) => <li>{cz(p)}</li>)}</ul>
          <div class="btns">
            <a class="txt-link" href={b.href}>{b.link}</a>
            <a class="txt-link" href="https://eshop.myskin.cz">Koupit v e-shopu</a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    root.classList.add('ready');
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => p.classList.toggle('on', i === j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') show((i - 1 + tabs.length) % tabs.length, true);
      });
    });
  });
</script>

<style>
  .brands__head { display: flex; justify-content: space-between; align-items: end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: clamp(28px, 3vw, 64px); }
  .brands__tabs { display: flex; gap: 10px; flex-wrap: wrap; }
  .brands__tabs button { display: grid; place-items: center; width: clamp(130px, 10vw, 190px); height: clamp(60px, 4.4vw, 84px); padding: 12px 18px; border: 1.5px solid var(--line); border-radius: var(--r-pill); background: var(--paper); cursor: pointer; transition: background var(--t-fast), border-color var(--t-fast); }
  .brands__tabs button :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; filter: invert(1) grayscale(1); opacity: .55; transition: opacity var(--t-fast); }
  .brands__tabs button:hover { border-color: var(--ink); }
  .brands__tabs button:hover :global(img) { opacity: .85; }
  .brands__tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); }
  .brands__tabs button[aria-selected='true'] :global(img) { filter: none; opacity: 1; }
  .brands__panel { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 120px); align-items: center; padding: clamp(28px, 3vw, 56px); background: var(--mist-light); border-radius: var(--r-img); }
  .brands__panel + .brands__panel { margin-top: 20px; }
  :global(.ready) .brands__panel:not(.on) { display: none; }
  :global(.ready) .brands__panel.on { animation: brandIn .5s var(--ease-out); }
  @keyframes brandIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .brands__img { background: #fff; border-radius: var(--r-img); aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 6%; }
  .brands__img :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .brands__text h3 { font-size: var(--fs-xl); font-variation-settings: 'opsz' 64; letter-spacing: -0.02em; }
  .brands__sub { font-weight: 600; margin: 8px 0 18px; }
  .brands__text > p:not(.brands__sub) { color: var(--graphite); max-width: 56ch; }
  .brands__text ul { margin: 18px 0 24px; display: grid; gap: 8px; }
  .brands__text li { padding-left: 20px; position: relative; color: var(--graphite); }
  .brands__text li::before { content: ""; position: absolute; left: 0; top: .65em; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
  .brands__text .btns { gap: 24px; }
  @media (max-width: 860px) { .brands__panel { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) {
    .brands__tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; gap: 8px; }
    .brands__tabs button { width: 100%; height: 52px; padding: 10px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(.ready) .brands__panel.on { animation: none; } }
</style>
