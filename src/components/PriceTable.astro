---
import { kc, bookingUrl, type PriceItem } from '../data/cenik';
import { cz } from '../lib/cz';
interface Props { items: PriceItem[]; heading?: string; note?: string; id?: string; showLinks?: boolean }
const { items, heading = 'Ceník', note, id = 'cenik', showLinks = false } = Astro.props;
---
<div class="prices" id={id}>
  {heading && <h2 class="prices__h split">{heading}</h2>}
  <ul class="prices__list">
    {items.map((it, i) => (
      <li data-reveal style={`--i: ${i % 5}`}>
        <span class="prices__name">
          {showLinks && it.href ? <a href={it.href}>{it.name}</a> : it.name}
          {(it.duration || it.note) && <small>{cz([it.duration, it.note].filter(Boolean).join(', '))}</small>}
        </span>
        <span class="prices__dots" aria-hidden="true"></span>
        <span class="prices__price">{kc(it.price)}{it.noona && <a class="prices__book" href={bookingUrl(it.noona)} target="_blank" rel="noopener" aria-label={`Rezervovat: ${it.name}`}>Rezervovat</a>}</span>
      </li>
    ))}
  </ul>
  {note && <p class="prices__note">{note}</p>}
</div>

<style>
  .prices__h { font-size: var(--fs-xl); margin-bottom: clamp(16px, 1.6vw, 32px); }
  .prices__list { border-top: 1px solid var(--line); }
  .prices__list li { display: grid; grid-template-columns: auto minmax(24px, 1fr) auto; align-items: baseline; gap: 14px; padding: clamp(14px, 1.2vw, 22px) 0; border-bottom: 1px solid var(--line); }
  .prices__name { font-weight: 600; }
  .prices__name a { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .prices__name small { display: block; font-weight: 400; font-size: var(--fs-sm); color: var(--graphite); margin-top: 2px; }
  .prices__dots { border-bottom: 2px dotted var(--mist); transform: translateY(-4px); }
  .prices__price { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .prices__book { display: block; margin-top: 4px; font-size: var(--fs-xs); font-weight: 600; text-align: right; text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prices__book:hover { text-decoration-color: var(--ink); }
  .prices__note { margin-top: 14px; font-size: var(--fs-sm); color: var(--graphite); }
</style>
