---
// Galerie ze studia: 4 fotky (Karina při práci, proces). Skutečné fotky salonu.
import { Image } from 'astro:assets';
import { img } from '../lib/content';
interface Props { items: { image: string; alt: string }[]; heading?: string }
const { items, heading = 'Ze studia' } = Astro.props;
---
{items.length > 0 && (
  <section class="sec gal" aria-labelledby="h-galerie">
    <div class="wrap">
      <h2 id="h-galerie" class="h2 split">{heading}</h2>
      <ul class="gal__grid">
        {items.slice(0, 4).map((it, i) => (
          <li class={`g${i + 1}`} data-reveal="clip" style={`--i: ${i % 2}`}>
            <Image src={img(it.image)} widths={[360, 600, 900, 1200]} sizes="(max-width: 700px) 50vw, 25vw" alt={it.alt} data-parallax="0.06" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .gal h2 { margin-bottom: clamp(24px, 2.4vw, 48px); }
  .gal__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(240px, 24vw, 520px); gap: clamp(10px, 1.1vw, 24px); }
  .gal__grid li { overflow: hidden; border-radius: var(--r-img); background: var(--mist-light); }
  .gal__grid :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .gal__grid li:hover :global(img) { transform: scale(1.04); }
  @media (max-width: 700px) {
    .gal__grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 62vw; }
  }
</style>
