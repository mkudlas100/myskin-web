---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoLight from '../assets/img/logo-svetle.svg';
import { salon } from '../data/salon';
import { footerServices, footerMore, legal } from '../data/navigace';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href="/" aria-label="MySkin – kosmetické studio, úvodní stránka"><Image src={logoLight} alt="" width={220} height={83} /></a>
        <div class="soc">
          <a href={salon.social.instagram} aria-label="MySkin na Instagramu"><Icon name="instagram" /></a>
          <a href={salon.social.facebook} aria-label="MySkin na Facebooku"><Icon name="facebook" /></a>
        </div>
      </div>
      <nav class="ftr__col" aria-label="Služby">
        <h2 class="f-title">Služby</h2>
        <ul>{footerServices.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="ftr__col" aria-label="Další odkazy">
        <h2 class="f-title">MySkin</h2>
        <ul>{footerMore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div class="ftr__col">
        <h2 class="f-title">Studio</h2>
        <address>
          {salon.street}<br />
          {salon.postalCode} {salon.city}
        </address>
        <p><a href={`tel:${salon.phoneHref}`}>{salon.phone}</a><br /><a href={`mailto:${salon.email}`}>{salon.email}</a></p>
        <p>{salon.hours}</p>
        <p><a class="u" href={salon.map}>Otevřít v Mapách Google</a></p>
      </div>
    </div>

    <div class="legal">
      <p>Provozovatel {salon.operator}, IČO {salon.ico}, {salon.street}, {salon.postalCode} {salon.city}</p>
      <ul>{legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <p>© {year} {salon.name}. Design <a href="https://anfilov.cz">ANFILOV</a> a <a href="https://www.archivisual.cz/">ARCHIVISUAL</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--ink); color: var(--on-ink); padding-block: 88px 36px; font-size: var(--fs-sm); }
  .ftr__top { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.2fr; gap: 40px; padding-bottom: 56px; }
  .ftr__brand :global(img) { width: 170px; height: auto; }
  .soc { display: flex; gap: 10px; margin-top: 28px; }
  .soc a { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(243, 243, 244, .3); transition: background var(--t-fast), color var(--t-fast); }
  .soc a:hover { background: var(--sand); color: var(--ink); }
  .soc :global(svg) { width: 20px; height: 20px; }
  .f-title { font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0; color: var(--sand); margin-bottom: 14px; font-variation-settings: 'opsz' 14; line-height: 1.4; }
  .ftr__col li a { display: inline-block; padding: 5px 0; }
  .ftr__col a:hover, .legal a:hover { text-decoration: underline; text-underline-offset: 4px; }
  address { font-style: normal; }
  .ftr__col p { margin-top: 12px; }
  .ftr__col a { display: inline-block; padding: 3px 0; }
  .u { text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }
  .legal { border-top: 1px solid rgba(243, 243, 244, .18); padding-top: 28px; font-size: var(--fs-xs); color: var(--on-ink-muted); display: grid; gap: 6px; }
  .legal ul { display: flex; flex-wrap: wrap; gap: 0 22px; }
  .legal a { display: inline-block; padding: 6px 0; }
  @media (max-width: 960px) { .ftr__top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .ftr__top { grid-template-columns: 1fr; gap: 36px; } }
</style>
