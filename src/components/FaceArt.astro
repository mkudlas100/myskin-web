---
// Interaktivní ilustrace pro Pomocníka s výběrem: klidná tvář s čelenkou (jako při ošetření),
// zavřené oči, jemný úsměv. Vrstvy se zapínají třídou na kořeni (.f-tzone, .f-acne, …) –
// ovládá je skript stránky nebo najetí na tlačítko v pásu na úvodu. Dekorace: aria-hidden,
// stav se čtenářům sděluje textem pod ilustrací.
interface Props { id?: string; class?: string; caption?: boolean }
const { id, class: cls, caption = false } = Astro.props;
const u = id ?? 'face';
const FACE = 'M150 74c-48 0-72 38-71 86 1 50 26 100 71 116 45-16 70-66 71-116 1-48-23-86-71-86z';
---
<figure class:list={['face', cls]} id={id} data-face>
  <svg viewBox="0 0 300 330" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={`${u}-skin`} cx="50%" cy="42%" r="62%">
        <stop offset="0" stop-color="#FCEFE6" />
        <stop offset=".7" stop-color="#F6DFD0" />
        <stop offset="1" stop-color="#EECDBB" />
      </radialGradient>
      <linearGradient id={`${u}-neck`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#E9C6B3" />
        <stop offset=".35" stop-color="#F4DACB" />
      </linearGradient>
      <radialGradient id={`${u}-gloss`} cx="50%" cy="45%" r="55%">
        <stop offset="0" stop-color="#FFFDF8" stop-opacity=".95" />
        <stop offset=".5" stop-color="#FFF3DC" stop-opacity=".6" />
        <stop offset="1" stop-color="#FFF3DC" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${u}-rose`} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#FF9C86" stop-opacity=".55" />
        <stop offset="1" stop-color="#FF9C86" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${u}-red`} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#E46F5B" stop-opacity=".75" />
        <stop offset="1" stop-color="#E46F5B" stop-opacity="0" />
      </radialGradient>
      <clipPath id={`${u}-clip`}><path d={FACE} /></clipPath>
    </defs>

    <!-- ramena a krk -->
    <path class="face__body" d="M60 330c4-34 30-50 62-56l6-20h44l6 20c32 6 58 22 62 56z" />
    <path d="M128 238v30c6 10 38 10 44 0v-30z" fill={`url(#${u}-neck)`} />
    <!-- vlasy: drdol a vlasy za hlavou -->
    <circle class="face__hair" cx="150" cy="40" r="26" />
    <path class="face__hair" d="M150 50c-58 0-86 44-82 104 6-30 18-52 40-64 14 8 70 8 84 0 22 12 34 34 40 64 4-60-24-104-82-104z" />
    <!-- uši -->
    <path class="face__ear" d="M82 158c-12-4-16 10-12 22 3 9 10 14 15 12M218 158c12-4 16 10 12 22-3 9-10 14-15 12" />
    <!-- tvář -->
    <path d={FACE} fill={`url(#${u}-skin)`} />

    <g clip-path={`url(#${u}-clip)`}>
      <!-- jemné líčko vždy (živější výraz) -->
      <ellipse cx="108" cy="198" rx="24" ry="16" fill={`url(#${u}-rose)`} opacity=".45" />
      <ellipse cx="192" cy="198" rx="24" ry="16" fill={`url(#${u}-rose)`} opacity=".45" />
      <!-- lesk T-zóny -->
      <g class="L L-tzone">
        <ellipse cx="150" cy="128" rx="42" ry="14" fill={`url(#${u}-gloss)`} />
        <ellipse cx="150" cy="182" rx="13" ry="30" fill={`url(#${u}-gloss)`} />
        <ellipse cx="150" cy="254" rx="24" ry="13" fill={`url(#${u}-gloss)`} />
        <path class="spark" d="M134 124l2 5 5 2-5 2-2 5-2-5-5-2 5-2z M154 172l1.6 4 4 1.6-4 1.6-1.6 4-1.6-4-4-1.6 4-1.6z" />
      </g>
      <!-- lesk tváří -->
      <g class="L L-cheeks">
        <ellipse cx="106" cy="194" rx="26" ry="24" fill={`url(#${u}-gloss)`} />
        <ellipse cx="194" cy="194" rx="26" ry="24" fill={`url(#${u}-gloss)`} />
      </g>
      <!-- suchost: jemné šupinky -->
      <g class="L L-dry ink-soft">
        <path d="M96 190l7-2M108 204l6 1M94 208l5-3M200 188l7 1M190 204l6-2M206 212l5 2M130 130l6-2M164 126l7 1" />
      </g>
      <!-- citlivost -->
      <g class="L L-blush">
        <ellipse cx="108" cy="202" rx="32" ry="24" fill={`url(#${u}-rose)`} />
        <ellipse cx="192" cy="202" rx="32" ry="24" fill={`url(#${u}-rose)`} />
      </g>
      <!-- růžovka -->
      <g class="L L-rosacea">
        <ellipse cx="108" cy="198" rx="34" ry="26" fill={`url(#${u}-red)`} />
        <ellipse cx="192" cy="198" rx="34" ry="26" fill={`url(#${u}-red)`} />
        <ellipse cx="150" cy="196" rx="16" ry="18" fill={`url(#${u}-red)`} />
        <path class="vein" d="M96 196c5-3 8 2 13-1M190 194c5 3 8-2 13 1M102 210c4-2 7 1 10-1" />
      </g>
      <!-- akné -->
      <g class="L L-acne dots-red">
        <circle cx="140" cy="252" r="2.8" /><circle cx="162" cy="258" r="2.4" /><circle cx="151" cy="266" r="2.1" />
        <circle cx="102" cy="208" r="2.6" /><circle cx="112" cy="220" r="2.1" /><circle cx="196" cy="212" r="2.7" /><circle cx="186" cy="224" r="2" />
        <circle cx="138" cy="130" r="2.2" /><circle cx="166" cy="134" r="2" />
      </g>
      <!-- černé tečky -->
      <g class="L L-pores dots-ink">
        <circle cx="145" cy="192" r="1.2" /><circle cx="151" cy="198" r="1.2" /><circle cx="157" cy="192" r="1.2" /><circle cx="147" cy="205" r="1" /><circle cx="155" cy="205" r="1" />
        <circle cx="143" cy="256" r="1" /><circle cx="158" cy="254" r="1" />
      </g>
      <!-- pigmentové skvrny -->
      <g class="L L-pigment dots-brown">
        <ellipse cx="104" cy="186" rx="7" ry="5" /><ellipse cx="118" cy="198" rx="4" ry="3" /><ellipse cx="198" cy="188" rx="6.5" ry="5" />
        <ellipse cx="186" cy="176" rx="3.5" ry="2.6" /><ellipse cx="166" cy="130" rx="6" ry="4" />
      </g>
      <!-- vrásky -->
      <g class="L L-wrinkles ink-soft">
        <path d="M122 132c18-4 38-4 56 0M128 141c14-3 30-3 44 0" />
        <path d="M90 160c-5 2-7 5-8 8M91 168c-5 1-7 3-9 6M210 160c5 2 7 5 8 8M209 168c5 1 7 3 9 6" />
        <path d="M128 212c-5 7-6 14-4 20M172 212c5 7 6 14 4 20" />
      </g>
    </g>

    <!-- čelenka (jako při ošetření) -->
    <path class="face__band" d="M76 124c18-30 46-44 74-44s56 14 74 44l-8 14c-16-24-40-36-66-36s-50 12-66 36z" />
    <path class="face__band-line" d="M86 124c16-22 38-32 64-32s48 10 64 32" />
    <!-- jemná linka čelisti -->
    <path class="face__jaw" d="M82 176c4 44 28 86 68 100 40-14 64-56 68-100" />
    <!-- obočí -->
    <path class="face__brow" d="M104 148c10-7 24-8 34-3M162 145c10-5 24-4 34 3" />
    <!-- zavřené oči s řasami -->
    <g class="face__eye">
      <path d="M106 164c8 7 22 7 30 0M164 164c8 7 22 7 30 0" />
      <path class="lash" d="M110 168l-3 4M116 170l-2 5M123 171l0 5M130 170l2 5M170 170l-2 5M177 171l0 5M184 170l2 5M190 168l3 4" />
    </g>
    <!-- linka (PMU) -->
    <path class="face__liner" d="M105 164c9 6 23 6 31 0M164 164c8 6 22 6 31 0" />
    <!-- nos -->
    <path class="face__nose" d="M151 168c-2 14-6 26-2 32M142 206c4 4 12 4 16 0" />
    <!-- rty s jemným úsměvem -->
    <path class="face__lips" d="M134 226c6-4 11-5 16-2 5-3 10-2 16 2-5 9-27 9-32 0z" />
    <path class="face__smile" d="M132 225c2 1 3 1 4 0M164 225c1 1 2 1 4 0" />
    <!-- odpočinek: lístky a jiskřičky -->
    <g class="L L-relax">
      <path class="leaf" d="M52 230c10-22 30-26 40-20-6 14-24 26-40 20zM248 226c-10-22-30-26-40-20 6 14 24 26 40 20z" />
      <path class="spark spark--soft" d="M62 120l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5zM240 96l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM250 150l1.6 4 4 1.6-4 1.6-1.6 4-1.6-4-4-1.6 4-1.6z" />
    </g>
  </svg>
  {caption && <figcaption class="face__cap" aria-live="polite"></figcaption>}
</figure>

<style is:global>
  .face { margin: 0; display: grid; justify-items: center; gap: 12px; }
  .face svg { width: 100%; height: auto; overflow: visible; }
  .face__body { fill: #F1E4D8; }
  .face__hair { fill: #5B4136; }
  .face__ear { fill: #F1D3C2; stroke: #D7AE9A; stroke-width: 1.4; stroke-linecap: round; }
  .face__band { fill: var(--sand); }
  .face__band-line { fill: none; stroke: #E2BE84; stroke-width: 1.5; stroke-dasharray: 2 5; stroke-linecap: round; }
  .face__jaw { fill: none; stroke: #DDB5A2; stroke-width: 1.4; stroke-linecap: round; }
  .face__brow { fill: none; stroke: #8A6A5C; stroke-width: 2.6; stroke-linecap: round; transition: stroke var(--t) var(--ease), stroke-width var(--t) var(--ease); }
  .face__eye path { fill: none; stroke: #4A3832; stroke-width: 1.8; stroke-linecap: round; }
  .face__eye .lash { stroke-width: 1.2; }
  .face__liner { fill: none; stroke: #2E2420; stroke-width: 3; stroke-linecap: round; opacity: 0; transition: opacity var(--t) var(--ease); }
  .face__nose { fill: none; stroke: #CFA390; stroke-width: 1.6; stroke-linecap: round; }
  .face__lips { fill: #EAA898; transition: fill var(--t) var(--ease); }
  .face__smile { fill: none; stroke: #C98C7C; stroke-width: 1.4; stroke-linecap: round; }
  .face .L { opacity: 0; transition: opacity var(--t) var(--ease); }
  .face .spark { fill: #fff; }
  .face .spark--soft { fill: var(--coral); opacity: .8; }
  .face .leaf { fill: #CBD8B8; }
  .face .ink-soft, .face .ink-soft path { fill: none; stroke: #B39184; stroke-width: 1.3; stroke-linecap: round; }
  .face .vein { fill: none; stroke: #C4513F; stroke-width: .9; opacity: .7; }
  .face .dots-red circle { fill: #D9604C; }
  .face .dots-ink circle { fill: #4A3832; }
  .face .dots-brown ellipse { fill: #C29572; opacity: .7; }
  .face__cap { font-size: var(--fs-sm); color: var(--graphite); text-align: center; min-height: 1.5em; margin: 0; }
  .face__cap strong { color: var(--ink); }
  /* stavy */
  .f-tzone .L-tzone, .f-cheeks .L-cheeks, .f-dry .L-dry, .f-blush .L-blush, .f-rosacea .L-rosacea, .f-acne .L-acne,
  .f-pores .L-pores, .f-pigment .L-pigment, .f-wrinkles .L-wrinkles, .f-relax .L-relax { opacity: 1; }
  .f-tzone-half .L-tzone { opacity: .55; }
  .f-pmu .face__brow { stroke: #4E3A32; stroke-width: 4.4; }
  .f-pmu .face__liner { opacity: 1; }
  .f-pmu .face__lips { fill: #D98777; }
  @media (prefers-reduced-motion: reduce) { .face .L, .face__brow, .face__lips, .face__liner { transition: none; } }
</style>
