---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo.svg';
import { menu } from '../data/navigace';
import { salon } from '../data/salon';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === path;
---
<header id="hdr" class="hdr">
  <div class="wrap hdr__in">
    <a class="logo" href="/" aria-label="MySkin – kosmetické studio, úvodní stránka">
      <Image src={logo} alt="MySkin – kosmetické studio Benešov"width={170} height={64} loading="eager" />
    </a>
    <nav id="nav" class="nav" aria-label="Hlavní menu">
      <ul class="menu">
        {menu.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <Icon name="chevron" class="chev" />}
            </a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="cta">
        <a class="btn eshop" href={salon.eshop} aria-label="E-shop"><Icon name="bag" class="bag" /><span class="eshop__txt">E-shop</span></a>
        <a class="btn btn--primary book" href={salon.booking}>Rezervovat termín</a>
      </div>
    </nav>
    <button class="burger" id="burger" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="nav"><span></span><span></span></button>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, .96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid transparent; transition: border-color var(--t); }
  :global(.hdr.scrolled) { border-bottom-color: var(--line); }
  .hdr { transition: border-color var(--t), transform .5s var(--ease); }
  :global(.hdr.hidden) { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: clamp(72px, 3vw + 40px, 120px); }
  .logo :global(img) { width: clamp(116px, 5vw + 66px, 220px); height: auto; }
  .nav { display: flex; align-items: center; gap: clamp(14px, 1.4vw, 36px); }
  .menu { display: flex; align-items: center; }
  .menu > li { position: relative; }
  .menu > li > a { display: flex; align-items: center; gap: 4px; min-height: 48px; padding: 0 clamp(8px, .7vw, 18px); font-size: var(--fs-sm); font-weight: 500; white-space: nowrap; }
  .menu > li > a:hover, .menu > li > a[aria-current] { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .menu :global(.chev) { width: 14px; height: 14px; opacity: .6; transition: transform var(--t-fast); }
  .has-sub:hover :global(.chev), .has-sub:focus-within :global(.chev) { transform: rotate(180deg); }
  .sub { position: absolute; top: 100%; left: 0; min-width: 240px; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--sh-2); padding: 8px; opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity var(--t-fast), transform var(--t-fast), visibility var(--t-fast); }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: 9px 12px; border-radius: 6px; font-size: var(--fs-sm); }
  .sub a:hover, .sub a[aria-current] { background: var(--mist-light); }
  .cta { display: flex; align-items: center; gap: 10px; }
  .cta .btn { white-space: nowrap; }
  .eshop { min-height: clamp(44px, 1vw + 32px, 58px); padding: 10px clamp(14px, 1vw, 24px); font-size: var(--fs-sm); gap: 8px; }
  .eshop :global(.bag) { width: 18px; height: 18px; }
  .book { min-height: clamp(44px, 1vw + 32px, 58px); padding: 10px clamp(18px, 1.2vw, 30px); font-size: var(--fs-sm); }
  .burger { display: none; width: 48px; height: 48px; border: 0; background: none; cursor: pointer; position: relative; z-index: 60; }
  .burger span { display: block; height: 2px; margin: 7px 11px; background: var(--ink); transition: transform var(--t-fast); }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(4.5px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { transform: translateY(-4.5px) rotate(-45deg); }

  @media (max-width: 1179px) and (min-width: 1061px) {
    .eshop { padding: 10px 14px; }
    .eshop__txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 1140px) {
    .menu > li > a { padding: 0 8px; }
    .nav { gap: 12px; }
  }
  @media (max-width: 1060px) {
    .hdr__in { min-height: 68px; }
    .logo :global(img) { width: 116px; }
    .burger { display: block; }
    .nav { position: fixed; inset: 0; z-index: 55; background: var(--paper); flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 28px; padding: 88px max(20px, env(safe-area-inset-left, 0px)) 40px; overflow-y: auto; opacity: 0; visibility: hidden; transition: opacity var(--t) var(--ease), visibility var(--t); }
    :global(.nav.open) { opacity: 1; visibility: visible; }
    .menu { flex-direction: column; align-items: stretch; }
    .menu > li { border-bottom: 1px solid var(--line); }
    .menu > li > a { font-size: var(--fs-md); font-weight: 600; padding: 10px 0; }
    .menu :global(.chev) { display: none; }
    .sub { position: static; opacity: 1; visibility: inherit; transform: none; box-shadow: none; border: 0; background: none; padding: 0 0 12px; min-width: 0; display: flex; flex-wrap: wrap; gap: 4px 18px; }
    .sub a { padding: 6px 0; color: var(--graphite); }
    .sub a:hover { background: none; text-decoration: underline; }
    .cta { flex-wrap: wrap; }
  }
</style>
