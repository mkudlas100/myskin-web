---
// Časté otázky jako rozbalovací seznam (otevírání animuje skript motion.ts). Odpovědi jsou v HTML i zavřené,
// takže je vidí vyhledávače i AI. První otázka je otevřená.
import { cz } from '../lib/cz';
interface Props { items: { q: string; a: string }[]; heading?: string; id?: string }
const { items, heading = 'Časté otázky', id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section class="sec faq" aria-labelledby={`h-${id}`}>
    <div class="wrap faq__grid">
      <h2 id={`h-${id}`} class="h2 split">{heading}</h2>
      <div class="faq__list">
        {items.map((f, i) => (
          <details class="qa" open={i === 0} data-reveal style={`--i: ${i % 4}`}>
            <summary><span>{cz(f.q)}</span><i aria-hidden="true"></i></summary>
            <div class="qa__a"><p>{cz(f.a)}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq { background: var(--mist-light); }
  .faq__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px clamp(40px, 5vw, 120px); align-items: start; }
  .faq__list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: clamp(18px, 1.6vw, 30px) 0; cursor: pointer; font-size: var(--fs-md); font-weight: 600; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; flex: 0 0 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--ink); transition: background var(--t-fast), transform var(--t) var(--ease-out); }
  summary i::before, summary i::after { content: ""; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform var(--t) var(--ease-out); }
  .qa[open] summary i { background: var(--sand); border-color: var(--sand); transform: rotate(180deg); }
  .qa[open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  summary:hover span { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .qa__a { overflow: hidden; }
  .qa__a p { padding: 0 0 clamp(18px, 1.6vw, 30px); color: var(--graphite); max-width: 68ch; }
  @media (max-width: 860px) { .faq__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
