---
import { stipple, type StippleShape } from '../lib/stipple';
interface Props { shape: StippleShape; class?: string; label?: string; amount?: number }
const { shape, class: cls, label, amount = 1 } = Astro.props;
const s = stipple(shape, amount);
---
<svg class:list={['stipple', `stipple--${shape}`, cls]} viewBox={`0 0 ${s.w} ${s.h}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" fill="none" stroke="currentColor" stroke-linecap="round">
  {s.outline && <path d={s.outline} stroke-width="1.2" opacity=".35" />}
  {s.groups.map((g) => <path d={g.d} stroke-width={g.size} opacity={g.o} />)}
</svg>
