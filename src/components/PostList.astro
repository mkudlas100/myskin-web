---
// Karty článků: fotka se odkryje, nadpis podtrhne korálová linka při najetí.
import { Image } from 'astro:assets';
import { img, rubriky, type Clanek } from '../lib/content';
import { cz } from '../lib/cz';
interface Props { posts: Clanek[]; heading?: string; more?: { label: string; href: string }; id?: string; level?: 'h2' | 'h3' }
const { posts, heading, more, id = 'clanky', level = 'h3' } = Astro.props;
const Tag = level;
---
{posts.length > 0 && (
  <section class="sec posts" aria-labelledby={heading ? `h-${id}` : undefined}>
    <div class="wrap">
      {heading && (
        <div class="posts__head">
          <h2 id={`h-${id}`} class="h2 split">{heading}</h2>
          {more && <a class="txt-link" href={more.href}>{more.label}</a>}
        </div>
      )}
      <ul class="posts__grid">
        {posts.map((p, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <a href={`/${p.id}`}>
              <span class="posts__img"><Image src={img(p.data.image)} widths={[360, 560, 800]} sizes="(max-width: 600px) 92vw, (max-width: 1060px) 46vw, 30vw" alt={p.data.imageAlt} /></span>
              <span class="posts__cat">{rubriky[p.data.category].title}</span>
              <Tag class="posts__title">{cz(p.data.title)}</Tag>
              <span class="posts__text">{cz(p.data.listDescription)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .posts__head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(32px, 3vw, 64px); }
  .posts__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(40px, 3.4vw, 80px) clamp(20px, 2.4vw, 56px); }
  .posts__grid a { display: flex; flex-direction: column; }
  .posts__img { display: block; overflow: hidden; border-radius: var(--r-img); aspect-ratio: 4 / 3; background: var(--mist-light); margin-bottom: 18px; }
  .posts__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .posts__grid a:hover .posts__img :global(img) { transform: scale(1.06); }
  .posts__cat { font-size: var(--fs-xs); color: var(--graphite); display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .posts__cat::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
  .posts__title { font-size: var(--fs-lg); line-height: 1.15; letter-spacing: -0.015em; font-variation-settings: 'opsz' 48; font-weight: 600; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 6px; transition: text-decoration-color var(--t-fast); }
  .posts__grid a:hover .posts__title { text-decoration-color: var(--coral); }
  .posts__text { margin-top: 10px; color: var(--graphite); }
  @media (max-width: 1060px) { .posts__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .posts__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
