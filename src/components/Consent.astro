---
// Souhlas s analytickými cookies (Google Analytics 4).
// GA se načte až po kliknutí na „Přijmout“ (zákon o elektronických komunikacích, opt-in).
// Volba se ukládá v localStorage pod klíčem myskin-consent ("granted" / "denied").
// Lištu lze znovu otevřít tlačítkem [data-consent-open] v patičce.
import { GA_ID } from '../data/analytics';
---
<div class="consent" id="consent" role="dialog" aria-live="polite" aria-labelledby="consent-title" hidden>
  <p class="consent__title" id="consent-title">Cookies pro měření návštěvnosti</p>
  <p class="consent__text">
    S vaším souhlasem měřím přes Google Analytics, které stránky čtete, abych web mohla zlepšovat.
    Bez souhlasu se nic neměří. Víc v <a href="/zasady-ochrany-osobnich-udaju#cookies">zásadách zpracování osobních údajů</a>.
  </p>
  <div class="consent__btns">
    <button type="button" class="btn consent__btn" data-consent="granted">Přijmout</button>
    <button type="button" class="btn consent__btn" data-consent="denied">Odmítnout</button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  (function () {
    var KEY = 'myskin-consent';
    var box = document.getElementById('consent');
    var get = function () { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
    var set = function (v) { try { localStorage.setItem(KEY, v); } catch (e) {} };
    var loaded = false;
    function loadGA() {
      if (loaded) return; loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    }
    function clearGA() {
      // Odvolání souhlasu: smazat cookies GA (_ga, _ga_*) na této doméně i na .myskin.cz.
      var host = location.hostname.replace(/^www\./, '');
      document.cookie.split(';').forEach(function (c) {
        var n = c.split('=')[0].trim();
        if (/^_ga/.test(n)) {
          ['', '; domain=' + location.hostname, '; domain=.' + host].forEach(function (d) {
            document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
          });
        }
      });
    }
    var choice = get();
    if (choice === 'granted') loadGA();
    else if (choice !== 'denied') box.hidden = false;

    box.addEventListener('click', function (e) {
      var v = e.target.closest('[data-consent]');
      if (!v) return;
      var val = v.getAttribute('data-consent');
      set(val);
      box.hidden = true;
      if (val === 'granted') loadGA();
      else { clearGA(); if (loaded) location.reload(); }
    });
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-consent-open]')) { box.hidden = false; box.querySelector('button').focus(); }
    });
  })();
</script>

<style>
  .consent { position: fixed; z-index: 60; left: 16px; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); max-width: 460px; padding: 22px 24px; background: #fff; color: var(--ink); border-radius: 14px; box-shadow: var(--sh-2), 0 0 0 1px rgba(42, 42, 44, .08); font-size: var(--fs-sm); line-height: 1.5; }
  .consent[hidden] { display: none; }
  .consent__title { font-weight: 700; margin: 0 0 6px; }
  .consent__text { margin: 0 0 16px; color: var(--muted); }
  .consent__text a { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .consent__btns { display: flex; gap: 10px; }
  .consent__btn { flex: 1; min-height: 46px; padding: 10px 18px; font-size: var(--fs-sm); }
  @media (min-width: 700px) { .consent { left: 24px; right: auto; bottom: 24px; } }
</style>
