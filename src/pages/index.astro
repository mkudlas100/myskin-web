---
import { Image, Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { salon } from '../data/salon';
import { salonNode, ownerNode } from '../lib/schema';

import logo from '../assets/img/logo.svg';
import portret from '../assets/img/uvod-portret.jpg';
import imgPmu from '../assets/img/sluzba-permanentni-make-up.png';
import imgPlet from '../assets/img/sluzba-osetreni-pleti.png';
import imgRasy from '../assets/img/sluzba-rasy-oboci.png';
import imgLiceni from '../assets/img/sluzba-liceni.jpg';
import imgDepilace from '../assets/img/sluzba-depilace.png';
import imgPedikura from '../assets/img/sluzba-pedikura.png';
import tym from '../assets/img/tym.jpg';
import g1 from '../assets/img/salon-lehatko.jpg';
import g2 from '../assets/img/salon-osetreni-obliceje.jpg';
import g3 from '../assets/img/salon-pletova-maska.jpg';
import g4 from '../assets/img/salon-kosmetika-phyts.jpg';
import g5 from '../assets/img/salon-cekarna.jpg';
import g6 from '../assets/img/salon-klientka.jpg';
import bPhyts from '../assets/img/znacka-phyts.png';
import bCollin from '../assets/img/znacka-gm-collin.png';
import bNoon from '../assets/img/znacka-noon.webp';
import qr from '../assets/img/noona-qr.webp';
import telefony from '../assets/img/noona-telefony.webp';

const title = 'Kosmetika a permanentní make-up Benešov | MySkin';
const description = 'Kosmetické studio MySkin v Benešově: permanentní make-up obočí, rtů a linek, ošetření pleti přírodní kosmetikou Phyt\'s a radiofrekvence. Rezervace online.';

const logoPng = await getImage({ src: logo, format: 'svg' });
const portretJpg = await getImage({ src: portret, width: 651, format: 'jpg' });
const schema = [
  salonNode(new URL(logoPng.src, Astro.site).href, new URL(portretJpg.src, Astro.site).href),
  ownerNode(),
];

const pillars = [
  {
    img: imgPmu, href: '/permanentni-make-up', title: 'Permanentní make-up', cta: 'Vše o permanentním make-upu',
    text: 'Obočí, rty a oční linky, které vypadají přirozeně a vydrží 2–3 roky. Tvar i barvu spolu nejdřív probereme na konzultaci a předkreslíme.',
    links: [
      { label: 'Pudrové obočí', href: '/permanentni-make-up-pudrove-oboci' },
      { label: 'Stínované rty', href: '/permanentni-make-up-stinovane-rty' },
      { label: 'Oční linky', href: '/permanentni-make-up-ocni-linky' },
    ],
  },
  {
    img: imgPlet, href: '/kosmeticke-osetreni', title: 'Kosmetická péče o pleť', cta: 'Vše o ošetření pleti',
    text: 'Ošetření podle typu a potřeb vaší pleti s kosmetikou Phyt\'s, G.M. Collin a NOON Aesthetics – od hydratace po chemický peeling a radiofrekvenci.',
    links: [
      { label: 'Kosmetické ošetření', href: '/kosmeticke-osetreni' },
      { label: 'Radiofrekvence', href: '/radiofrekvence' },
      { label: 'Chemický peeling', href: '/kura-chemicky-peeling' },
      { label: 'Péče o citlivou pleť', href: '/pece-o-citlivou-plet' },
    ],
  },
];

const more = [
  { img: imgRasy, href: '/rasy-oboci', title: 'Řasy a obočí', text: 'Lash lifting, laminace obočí, prodlužování řas' },
  { img: imgLiceni, href: '/liceni', title: 'Líčení', text: 'Denní, plesové i svatební líčení' },
  { img: imgDepilace, href: '/depilace', title: 'Depilace', text: 'Teplým včelím voskem' },
  { img: imgPedikura, href: '/pedikura', title: 'Pedikúra', text: 'Suchá přístrojová pedikúra' },
];

const gallery = [
  { img: g1, cls: 'g1', alt: 'Kosmetické lehátko v salonu MySkin' },
  { img: g2, cls: 'g2', alt: 'Ošetření obličeje v salonu MySkin' },
  { img: g3, cls: 'g3', alt: 'Nanášení pleťové masky' },
  { img: g4, cls: 'g4', alt: 'Přírodní kosmetika Phyt\'s na poličce' },
  { img: g5, cls: 'g5', alt: 'Křesla v čekárně salonu' },
  { img: g6, cls: 'g6', alt: 'Klientka se sklenkou v salonu MySkin', pos: 'center 62%' },
];
const galleryFull = await Promise.all(gallery.map((g) => getImage({ src: g.img, width: 1600, format: 'webp' })));

const articles = [
  { href: '/jak-se-pripravit-na-permanentni-make-up', title: 'Jak se připravit na permanentní make-up', text: 'Co dělat čtyři týdny, dva týdny i den před zákrokem a kdy je lepší ho odložit.' },
  { href: '/pudrove-oboci-den-po-dni', title: 'Pudrové obočí den po dni', text: 'Proč je obočí první dny tmavé, po týdnu skoro zmizí a pak se vrátí.' },
  { href: '/vse-co-potebujete-vedet-o-radiofrekvencni-peci', title: 'Radiofrekvence pleti: účinky a průběh', text: 'Jak radiofrekvence funguje, pro koho je vhodná a kolik sezení potřebujete.' },
];
---
<Base title={title} description={description} schema={schema}>

  <!-- ================= ÚVOD ================= -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__text">
        <h1 class="eyebrow fade" style="--d:0s">Kosmetické studio MySkin v Benešově</h1>
        <p class="display" id="heroTitle">Krása by měla začít v&nbsp;srdci a&nbsp;<span class="ul">duši<svg viewBox="0 0 120 16" preserveAspectRatio="none" aria-hidden="true"><path d="M2 11 C 30 2, 62 2, 118 9" /></svg></span></p>
        <p class="hero__lead fade" style="--d:.8s">Specializuji se na permanentní make-up a péči o pleť přírodní kosmetikou. Každé ošetření přizpůsobím vaší pleti a tomu, co od něj čekáte.</p>
        <div class="btns fade" style="--d:.95s">
          <a class="btn btn--primary" href={salon.booking}>Rezervovat termín</a>
          <a class="btn" href="#sluzby">Prohlédnout služby</a>
        </div>
      </div>
      <Picture class="hero__photo fade" style="--d:.2s" src={portret} formats={['avif', 'webp']} widths={[440, 651]} sizes="(max-width: 960px) 90vw, 440px" alt="Usměvavá žena se zdravou pletí" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <!-- ================= SLUŽBY ================= -->
  <section class="sec services" id="sluzby" aria-labelledby="h-sluzby">
    <div class="wrap">
      <h2 class="h2 center rv" id="h-sluzby">Co u mě najdete</h2>
      <div class="pillars">
        {pillars.map((p, i) => (
          <article class="pillar rv" style={`--d:${i * 0.1}s`}>
            <a class="pillar__pic" href={p.href} tabindex="-1" aria-hidden="true">
              <Image src={p.img} alt="" widths={[180, 360]} sizes="180px" />
            </a>
            <div class="pillar__body">
              <h3><a href={p.href}>{p.title}</a></h3>
              <p>{p.text}</p>
              <ul class="pillar__links">
                {p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
              <a class="btn" href={p.href}>{p.cta}</a>
            </div>
          </article>
        ))}
      </div>

      <h3 class="more__title rv">Další služby</h3>
      <ul class="more">
        {more.map((s, i) => (
          <li class="rv" style={`--d:${i * 0.06}s`}>
            <a href={s.href}>
              <span class="more__pic"><Image src={s.img} alt="" widths={[160, 320]} sizes="160px" /></span>
              <span class="more__name">{s.title}</span>
              <span class="more__text">{s.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="center rv"><a class="btn" href="/cenik">Zobrazit ceník</a></p>
    </div>
  </section>

  <!-- ================= NA ČEM SI ZAKLÁDÁM ================= -->
  <section class="sec why" aria-labelledby="h-proc">
    <div class="wrap center">
      <span class="sec-icon rv"><Icon name="team" /></span>
      <h2 class="h2 rv" id="h-proc">Čistota, kvalitní kosmetika a&nbsp;individuální přístup</h2>
      <p class="lead rv">Salon je malý a klidný, přijímám na objednání a na každou klientku mám čas. Před ošetřením se vždy zeptám, co vás trápí, a podle toho vyberu postup i přípravky.</p>
      <ul class="why__grid">
        <li class="rv"><span class="mini"><Icon name="home" /></span><h3>Přírodní kosmetika</h3><p>Pracuji s certifikovanou BIO kosmetikou Phyt's a s ověřenými profesionálními značkami.</p></li>
        <li class="rv" style="--d:.08s"><span class="mini"><Icon name="dish" /></span><h3>Všechno na jednom místě</h3><p>Pleť, řasy, obočí, permanentní make-up, depilace i pedikúra pod jednou střechou.</p></li>
        <li class="rv" style="--d:.16s"><span class="mini"><Icon name="stretch" /></span><h3>Stále se vzdělávám</h3><p>Novinky z oboru si nejdřív vyzkouším na školení a teprve potom je nabídnu vám.</p></li>
        <li class="rv" style="--d:.24s"><span class="mini"><Icon name="wolf" /></span><h3>15 let praxe</h3><p>Začínala jsem v Asklepionu a Yves Rocher, permanentnímu make-upu se věnuji od roku 2021.</p></li>
      </ul>
    </div>
  </section>

  <!-- ================= TÝM ================= -->
  <section class="sec team" aria-labelledby="h-tym">
    <Image class="team__art" src={imgPlet} alt="" widths={[500]} sizes="500px" />
    <div class="wrap team__in">
      <Picture class="team__photo rv" src={tym} formats={['avif', 'webp']} widths={[560, 900, 1200]} sizes="(max-width: 960px) 92vw, 560px" alt="Karina Kudličková s kolegyněmi Michaelou Benešovou a Monikou Vratnou v salonu MySkin" />
      <div class="team__text rv" style="--d:.1s">
        <h2 class="h2" id="h-tym">Poznejte náš tým</h2>
        <p>Rády vám pomůžeme vybrat ošetření a přípravky, které podpoří váš přirozený vzhled. Chceme, aby pro vás každá návštěva byla chvílí odpočinku od běžného shonu.</p>
        <ul class="team__list">
          <li>Michaela Benešová – kosmetička a vizážistka</li>
          <li>Monika Vratná – pedikérka</li>
        </ul>
        <p class="team__sign">Karina Kudličková</p>
        <p class="team__role">majitelka salonu, kosmetička a specialistka na permanentní make-up</p>
        <a class="btn" href="/o-mne">Více o nás</a>
      </div>
    </div>
  </section>

  <!-- ================= GALERIE ================= -->
  <section class="sec" aria-labelledby="h-salon">
    <div class="wrap center">
      <span class="sec-icon rv"><Icon name="spa" /></span>
      <h2 class="h2 rv" id="h-salon">Přijďte na chvíli zapomenout na všední starosti</h2>
      <p class="lead rv">Salon najdete v Benešově na Pražské ulici. Je tu klid, pohodlné lehátko a čas jen pro vás.</p>
      <ul class="gallery">
        {gallery.map((g, i) => (
          <li class={`${g.cls} rv`} style={`--d:${(i % 2) * 0.08}s`}>
            <button class="g-item" type="button" data-full={galleryFull[i].src} data-alt={g.alt} aria-label={`Zvětšit fotku: ${g.alt}`}>
              <Picture src={g.img} formats={['avif', 'webp']} widths={[480, 760, 1100]} sizes="(max-width: 600px) 92vw, (max-width: 1170px) 55vw, 660px" alt={g.alt} style={g.pos ? `object-position:${g.pos}` : undefined} />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lb" id="lb" aria-label="Zvětšená fotka">
    <button class="lb__close" type="button" aria-label="Zavřít">×</button>
  </dialog>

  <!-- ================= ZNAČKY A E-SHOP ================= -->
  <section class="sec brands" aria-labelledby="h-znacky">
    <div class="wrap">
      <div class="center">
        <span class="sec-icon rv"><Icon name="organic" /></span>
        <h2 class="h2 rv" id="h-znacky">Kosmetika, se kterou pracuji</h2>
        <p class="lead rv">Používám profesionální kosmetiku tří značek. Stejné přípravky pro domácí péči si můžete koupit v e-shopu.</p>
        <p class="rv brands__cta"><a class="btn" href={`${salon.eshop}/prirodni-kosmetika`}>Navštívit e-shop</a></p>
      </div>
      <div class="brands__grid">
        <article class="brand rv">
          <div class="brand__pic"><Image src={bPhyts} alt="Sérum Phyt's" height={220} widths={[180, 360]} sizes="180px" /></div>
          <h3>PHYT'S</h3>
          <p class="brand__origin">Francouzská BIO kosmetika</p>
          <p>Jedna z předních francouzských značek profesionální péče o pleť. Pracuje s ní přes 3 000 salonů ve 47 zemích.</p>
          <ul>
            <li>Certifikované BIO složení z rostlinných extraktů a esenciálních olejů</li>
            <li>Bez parabenů a syntetických barviv</li>
          </ul>
        </article>
        <article class="brand rv" style="--d:.1s">
          <div class="brand__pic"><Image src={bCollin} alt="Přípravky G.M. Collin" widths={[340, 680]} sizes="340px" /></div>
          <h3>G.M. Collin</h3>
          <p class="brand__origin">Kanadská dermokosmetika</p>
          <p>Od roku 1957 spojuje přírodní složky s biotechnologiemi. Přípravky vznikají v Montrealu ve spolupráci s dermatology.</p>
          <ul>
            <li>Klinicky testované přípravky</li>
            <li>Peptidy, kyselina hyaluronová a probiotika pro hydrataci a regeneraci</li>
          </ul>
        </article>
        <article class="brand rv" style="--d:.2s">
          <div class="brand__pic"><Image src={bNoon} alt="Přípravky NOON Aesthetics" height={240} widths={[200, 400]} sizes="200px" /></div>
          <h3>NOON Aesthetics</h3>
          <p class="brand__origin">Izraelská dermokosmetika</p>
          <p>Technologie DermShield™ umožňuje použít vysoké koncentrace účinných látek a přitom šetřit pleť. Hodí se i pro citlivou pleť.</p>
          <ul>
            <li>Vysoké koncentrace účinných látek</li>
            <li>Bez parfemace a parabenů</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= TIPY ================= -->
  <section class="sec tips" aria-labelledby="h-tipy">
    <div class="wrap">
      <div class="center">
        <span class="sec-icon rv"><Icon name="blog" /></span>
        <h2 class="h2 rv" id="h-tipy">Tipy od Kariny</h2>
        <p class="lead rv">Jak pečovat o pleť v každém ročním období, jak se připravit na permanentní make-up a které přírodní přípravky opravdu fungují. Sdílím, co se mi osvědčilo za 15 let praxe.</p>
      </div>
      <ul class="tips__grid">
        {articles.map((a, i) => (
          <li class="rv" style={`--d:${i * 0.08}s`}>
            <a href={a.href}>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="tips__more" aria-hidden="true">Číst článek</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="center rv"><a class="btn" href="/blog-myskin">Všechny články</a></p>
    </div>
  </section>

  <!-- ================= REZERVACE ================= -->
  <section class="sec booking" aria-labelledby="h-rezervace">
    <div class="wrap booking__in">
      <div class="rv">
        <h2 class="h2" id="h-rezervace">Rezervace v mobilu</h2>
        <p>Termín si zarezervujete online během chvilky. V aplikaci Noona pak vidíte všechny své návštěvy na jednom místě a můžete je snadno přesunout.</p>
        <div class="booking__qr">
          <a href={salon.noonaQr}><Image src={qr} alt="QR kód ke stažení aplikace Noona" width={112} height={112} /></a>
          <span>Naskenujte kód a stáhněte si aplikaci Noona.</span>
        </div>
        <div class="btns">
          <a class="btn btn--primary" href={salon.booking}>Rezervovat termín</a>
          <a class="btn" href={salon.noonaApp}>Stáhnout aplikaci</a>
        </div>
      </div>
      <Image class="booking__phones rv" style="--d:.1s" src={telefony} alt="Aplikace Noona na dvou telefonech" widths={[460, 920]} sizes="(max-width: 960px) 80vw, 460px" />
    </div>
  </section>

</Base>

<script>
  // Nástup nadpisu úvodu po slovech (jeden orchestrovaný moment stránky).
  const h = document.getElementById('heroTitle');
  if (h && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Čtečky obrazovky čtou celou větu ze skrytého textu, rozdělená slova jsou aria-hidden.
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    sr.textContent = (h.textContent || '').replace(/\s+/g, ' ').trim();
    let i = 0;
    const split = (node: Node) => {
      Array.from(node.childNodes).forEach((n) => {
        if (n.nodeType === 3) {
          const frag = document.createDocumentFragment();
          (n.textContent || '').split(/(\s+)/).forEach((p) => {
            if (!p) return;
            if (/^\s+$/.test(p)) { frag.appendChild(document.createTextNode(' ')); return; }
            const w = document.createElement('span'); w.className = 'w'; w.setAttribute('aria-hidden', 'true');
            const s = document.createElement('span'); s.style.setProperty('--i', String(i++)); s.textContent = p;
            w.appendChild(s); frag.appendChild(w);
          });
          n.parentNode?.replaceChild(frag, n);
        } else if (n.nodeType === 1 && (n as Element).tagName.toLowerCase() !== 'svg') {
          split(n);
        }
      });
    };
    split(h);
    h.prepend(sr);
    h.classList.add('split');
  }

  // Galerie – zvětšení fotky v dialogu (Esc zavírá nativně).
  const lb = document.getElementById('lb') as HTMLDialogElement | null;
  const lbImg = document.createElement('img');
  lb?.prepend(lbImg);
  document.querySelectorAll<HTMLButtonElement>('.g-item').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!lb) return;
      lbImg.src = btn.dataset.full || '';
      lbImg.alt = btn.dataset.alt || '';
      lb.showModal();
    });
  });
  lb?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === lb || t.classList.contains('lb__close')) lb.close();
  });
</script>

<style>
  /* ---------- ÚVOD ---------- */
  .hero { background: var(--sand); padding-top: 116px; overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: end; gap: 40px; }
  .hero__text { padding-block: 28px 96px; }
  .eyebrow { font-size: var(--fs-sm); font-weight: 600; letter-spacing: 2.5px; color: var(--brown-deep); }
  .display { font-size: var(--fs-hero); font-weight: 500; line-height: 1.2; margin: 14px 0 24px; max-width: 520px; }
  .ul { position: relative; white-space: nowrap; }
  .ul svg { position: absolute; left: -3%; bottom: -8px; width: 106%; height: 16px; overflow: visible; }
  .ul path { fill: none; stroke: var(--coral); stroke-width: 3; stroke-linecap: round; }
  .hero__lead { font-size: var(--fs-md); font-weight: 500; line-height: 1.65; max-width: 480px; margin-bottom: 30px; }
  .hero :global(.hero__photo) { justify-self: center; width: 100%; max-width: 440px;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 14%); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 14%); mask-composite: intersect; }

  :global(.js) .display.split :global(.w) { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .08em; margin-bottom: -.08em; }
  :global(.js) .display.split :global(.w > span) { display: inline-block; transform: translateY(105%); animation: rise .9s var(--ease) forwards; animation-delay: calc(.1s + var(--i) * .07s); }
  :global(.js) .ul path { stroke-dasharray: 240; stroke-dashoffset: 240; animation: draw 1s var(--ease) 1s forwards; }
  :global(.js) .fade, :global(.js) .hero :global(.fade) { opacity: 0; animation: fadeup .8s var(--ease) forwards; animation-delay: var(--d, 0s); }
  @keyframes rise { to { transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fadeup { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* ---------- SLUŽBY ---------- */
  .services { background: linear-gradient(var(--paper), var(--sand-soft)); }
  .pillars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); margin-top: 56px; }
  .pillar { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 28px; align-items: start; background: #fff; border-radius: var(--r-card); padding: 32px; box-shadow: var(--sh-1); }
  .pillar__pic { display: block; width: 180px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px #EFE6D8; transition: box-shadow var(--t) var(--ease); }
  .pillar__pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .pillar:hover .pillar__pic { box-shadow: 0 0 0 10px var(--sand); }
  .pillar:hover .pillar__pic :global(img) { transform: scale(1.05); }
  .pillar h3 { font-size: var(--fs-xl); font-weight: 600; line-height: 1.25; margin-bottom: 10px; }
  .pillar h3 a:hover { color: var(--brown-deep); }
  .pillar p { color: var(--muted); margin-bottom: 14px; }
