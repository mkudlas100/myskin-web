---
import { Image, Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stipple from '../components/Stipple.astro';
import { salon } from '../data/salon';
import { cz } from '../lib/cz';
import { salonNode, ownerNode } from '../lib/schema';

import logo from '../assets/img/logo.svg';
import klientka from '../assets/img/salon-klientka.jpg';
import osetreni from '../assets/img/salon-osetreni-obliceje.jpg';
import tym from '../assets/img/tym.jpg';
import cekarna from '../assets/img/salon-cekarna.jpg';
import lehatko from '../assets/img/salon-lehatko.jpg';
import phyts from '../assets/img/salon-kosmetika-phyts.jpg';
import maska from '../assets/img/salon-pletova-maska.jpg';
import qr from '../assets/img/noona-qr.webp';

const title = 'Kosmetika a permanentní make-up Benešov | MySkin';
const description = 'Kosmetické studio MySkin v Benešově: permanentní make-up obočí, rtů a linek, ošetření pleti přírodní kosmetikou Phyt\'s a radiofrekvence. Rezervace online.';

const logoUrl = (await getImage({ src: logo, format: 'svg' })).src;
const salonImg = (await getImage({ src: cekarna, width: 1200, format: 'jpg' })).src;
const schema = [salonNode(new URL(logoUrl, Astro.site).href, new URL(salonImg, Astro.site).href), ownerNode()];

const pmu = [
  { shape: 'brow', href: '/permanentni-make-up-pudrove-oboci', name: 'Pudrové obočí', text: 'Stínované obočí s jemným přechodem od začátku ke konci. Doplní tvar, objem i hustotu, i když chloupky chybí.' },
  { shape: 'lips', href: '/permanentni-make-up-stinovane-rty', name: 'Stínované rty', text: 'Sjednotí barvu a obrys rtů, takže vypadají upraveně i bez rtěnky.' },
  { shape: 'liner', href: '/permanentni-make-up-ocni-linky', name: 'Oční linky', text: 'Linka v řasové linii, která se nerozmaže při sportu, v sauně ani v bazénu.' },
] as const;

const care = [
  { href: '/kosmeticke-osetreni', name: 'Kosmetické ošetření' },
  { href: '/pece-o-citlivou-plet', name: 'Péče o citlivou pleť' },
  { href: '/kura-chemicky-peeling', name: 'Chemický peeling' },
  { href: '/radiofrekvence', name: 'Radiofrekvence obličeje a těla' },
  { href: '/kompletni-osetreni-pro-muze', name: 'Ošetření pro muže' },
];

const timeline = [
  { y: '2005', t: 'Beauty & Art Academy', d: 'trvalé řasy a mikromasáž' },
  { y: '2007', t: 'Yves Rocher', d: 'kosmetička a poradkyně, osm let' },
  { y: '2011', t: 'Asklepion', d: 'kosmetička na klinice estetické medicíny' },
  { y: '2017', t: 'Asociace vizážistů a stylistů ČR', d: 'fotomakeup' },
  { y: '2021', t: 'Fleiš Academy', d: 'permanentní make-up' },
  { y: '2024', t: 'Fleiš Academy', d: 'pigmentologie a teorie barev' },
];

const more = [
  { href: '/rasy-oboci', name: 'Řasy a obočí', text: 'Lash lifting, laminace obočí, prodlužování řas' },
  { href: '/liceni', name: 'Líčení', text: 'Denní, plesové i svatební' },
  { href: '/depilace', name: 'Depilace', text: 'Teplým včelím voskem' },
  { href: '/pedikura', name: 'Pedikúra', text: 'Suchá přístrojová pedikúra' },
];

const posts = [
  { href: '/jak-se-pripravit-na-permanentni-make-up', title: 'Jak se připravit na permanentní make-up', text: 'Co dělat čtyři týdny, dva týdny i den před zákrokem a kdy je lepší ho odložit.' },
  { href: '/pudrove-oboci-den-po-dni', title: 'Pudrové obočí den po dni', text: 'Proč je obočí první dny tmavé, po týdnu skoro zmizí a pak se vrátí.' },
  { href: '/vse-co-potebujete-vedet-o-radiofrekvencni-peci', title: 'Radiofrekvence pleti: účinky a průběh', text: 'Jak radiofrekvence funguje, pro koho je vhodná a kolik sezení potřebujete.' },
];
---
<Base title={title} description={description} schema={schema}>

  <!-- Úvod: obočí z&nbsp;teček pigmentu, nadpis, fotka ze studia -->
  <section class="hero" aria-labelledby="h-uvod">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <div class="hero__brow"><Stipple shape="brow" /></div>
        <h1 id="h-uvod">Permanentní make-up a&nbsp;péče o&nbsp;pleť v&nbsp;Benešově</h1>
        <p class="hero__lead">Jsem Karina Kudličková. Ve studiu na Pražské ulici dělám pudrové obočí, stínované rty a&nbsp;oční linky a&nbsp;pečuji o&nbsp;citlivou i&nbsp;problémovou pleť.</p>
        <div class="btns">
          <a class="btn btn--primary" href={salon.booking}>Rezervovat termín</a>
          <a class="btn" href="/cenik">Ceník</a>
        </div>
        <dl class="facts">
          <div><dt>Studio</dt><dd><a href={salon.map}>{salon.street}, Benešov</a></dd></div>
          <div><dt>Objednávky</dt><dd>Po–Pá, <a href={`tel:${salon.phoneHref}`}>{salon.phone}</a></dd></div>
        </dl>
      </div>
      <figure class="hero__photo">
        <Picture src={klientka} formats={['avif', 'webp']} widths={[420, 640, 880, 1100]} sizes="(max-width: 860px) 100vw, 46vw" alt="Klientka v čekárně studia MySkin" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- Permanentní make-up -->
  <section class="sec pmu" aria-labelledby="h-pmu">
    <div class="wrap pmu__grid">
      <div class="pmu__head">
        <h2 id="h-pmu" class="h2">Permanentní make-up</h2>
        <p>Pigment ukládám jemnými jehličkami do svrchní vrstvy pokožky. Cílem je přirozený výsledek, který ráno nemusíte dokreslovat.</p>
        <a class="txt-link" href="/permanentni-make-up">Vše o&nbsp;permanentním make-upu</a>
      </div>
      <ul class="pmu__list">
        {pmu.map((p) => (
          <li>
            <a href={p.href}>
              <Stipple shape={p.shape} class="pmu__art" amount={0.45} />
              <span class="pmu__name">{p.name}</span>
              <span class="pmu__text">{cz(p.text)}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pmu__fit">
        <h3>Hodí se hlavně, když</h3>
        <ul>
          <li>máte alergii na běžnou dekorativní kosmetiku,</li>
          <li>se vám líčení rozmazává při sportu nebo v&nbsp;teple,</li>
          <li>chcete ráno ušetřit čas u&nbsp;zrcadla.</li>
        </ul>
        <p>Každému zákroku předchází konzultace, na které spolu probereme tvar a&nbsp;barvu.</p>
      </div>
    </div>
  </section>

  <!-- Péče o&nbsp;pleť -->
  <section class="care" aria-labelledby="h-care">
    <figure class="care__photo">
      <Image src={osetreni} widths={[640, 960, 1280, 1600]} sizes="(max-width: 860px) 100vw, 55vw" alt="Ošetření obličeje ve studiu MySkin" />
    </figure>
    <div class="care__text">
      <h2 id="h-care" class="h2">Péče o&nbsp;pleť</h2>
      <blockquote class="quote">
        <p>„Vím, že pokožka dokáže říci o&nbsp;našem zdraví a&nbsp;kondici více, než si myslíme.“</p>
        <footer>Karina Kudličková</footer>
      </blockquote>
      <p>Nejčastěji pracuji s&nbsp;citlivou a&nbsp;problémovou pletí: s&nbsp;pigmentovými skvrnami, akné a&nbsp;růžovkou. Používám francouzskou BIO kosmetiku Phyt’s, kanadskou G.M.&nbsp;Collin a&nbsp;izraelskou NOON Aesthetics.</p>
      <ul class="care__list">
        {care.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
      </ul>
      <a class="txt-link" href="/kosmeticke-sluzby">Všechny kosmetické služby</a>
    </div>
  </section>

  <!-- Karina a&nbsp;tým -->
  <section class="sec karina" aria-labelledby="h-karina">
    <div class="wrap karina__grid">
      <figure class="karina__photo">
        <Image src={tym} widths={[480, 720, 960, 1200]} sizes="(max-width: 860px) 100vw, 44vw" alt="Tým studia MySkin: Karina Kudličková, Michaela Benešová a Monika Vratná" />
      </figure>
      <div class="karina__text">
        <h2 id="h-karina" class="h2">Karina Kudličková</h2>
        <p class="karina__role">Kosmetička a&nbsp;specialistka na permanentní make-up</p>
        <p>S&nbsp;kosmetikou pracuji přes patnáct let. Začínala jsem ve firmě Yves Rocher, prošla klinikou estetické medicíny a&nbsp;dnes se ve vlastním studiu věnuji hlavně permanentnímu make-upu a&nbsp;problematické pleti.</p>
        <ol class="timeline" aria-label="Vzdělání a&nbsp;praxe">
          {timeline.map((i) => <li><span class="timeline__y">{i.y}</span><span><strong>{i.t}</strong> {cz(i.d)}</span></li>)}
        </ol>
        <div class="team">
          <p><strong>Michaela Benešová</strong> kosmetička a&nbsp;vizážistka, víc než deset let praxe</p>
          <p><strong>Monika Vratná</strong> pedikérka, suchá pedikúra a&nbsp;péče o&nbsp;nohy</p>
        </div>
        <a class="txt-link" href="/o-mne">Více o&nbsp;nás</a>
      </div>
    </div>
  </section>

  <!-- Další služby, kurzy, e-shop -->
  <section class="sec more" aria-labelledby="h-more">
    <div class="wrap more__grid">
      <div>
        <h2 id="h-more" class="h2">Další služby</h2>
        <ul class="more__list">
          {more.map((m) => <li><a href={m.href}><span class="more__name">{m.name}</span><span class="more__text">{cz(m.text)}</span></a></li>)}
        </ul>
      </div>
      <div class="more__side">
        <div>
          <h3>Kurzy</h3>
          <p>Mini kurz líčení pro vás a&nbsp;refresh kurz pro kosmetičky.</p>
          <a class="txt-link" href="/kurzy-a-workshopy">Kurzy a&nbsp;workshopy</a>
        </div>
        <div>
          <h3>E-shop</h3>
          <p>Kosmetiku, se kterou pracuji ve studiu, si můžete objednat domů.</p>
          <a class="txt-link" href={salon.eshop}>Otevřít e-shop</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio -->
  <section class="studio" aria-labelledby="h-studio">
    <div class="wrap">
      <h2 id="h-studio" class="studio__h">Studio na Pražské 380</h2>
      <div class="studio__grid">
        <Image class="s1" src={cekarna} widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 58vw" alt="Čekárna studia s křesly a vitrínou kosmetiky" />
        <Image class="s2" src={phyts} widths={[400, 700, 1000]} sizes="(max-width: 860px) 50vw, 38vw" alt="Kosmetika Phyt’s na skleněné polici" />
        <Image class="s3" src={lehatko} widths={[400, 700, 1000]} sizes="(max-width: 860px) 50vw, 38vw" alt="Kosmetické lehátko s ručníkem Phyt’s" />
        <Image class="s4" src={maska} widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 58vw" alt="Nanášení pleťové masky při ošetření" />
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="sec blog" aria-labelledby="h-blog">
    <div class="wrap blog__grid">
      <div>
        <h2 id="h-blog" class="h2">Z&nbsp;blogu</h2>
        <a class="txt-link" href="/blog-myskin">Všechny články</a>
      </div>
      <ul class="blog__list">
        {posts.map((p) => <li><a href={p.href}><h3>{p.title}</h3><p>{cz(p.text)}</p></a></li>)}
      </ul>
    </div>
  </section>

  <!-- Rezervace -->
  <section class="sec booking" id="rezervace" aria-labelledby="h-book">
    <div class="wrap">
      <p class="book__motto">Krása by měla začít v&nbsp;srdci a&nbsp;duši.</p>
      <div class="book__grid">
        <div>
          <h2 id="h-book" class="book__h">Objednejte se</h2>
          <p>Termín si vyberete online v&nbsp;rezervačním systému Noona, nebo mi zavolejte.</p>
          <div class="btns">
            <a class="btn btn--primary" href={salon.booking}>Rezervovat online</a>
            <a class="btn" href={`tel:${salon.phoneHref}`}>{salon.phone}</a>
          </div>
        </div>
        <div class="book__qr">
          <a href={salon.noonaQr}><Image src={qr} alt="QR kód pro stažení aplikace Noona" width={120} height={120} /></a>
          <p>V&nbsp;aplikaci Noona budete mít své termíny v&nbsp;telefonu. Stačí naskenovat kód.</p>
        </div>
        <div>
          <h3>Kde nás najdete</h3>
          <address>{salon.street}<br />{salon.postalCode} {salon.city}</address>
          <p>{salon.hours}</p>
          <a class="txt-link" href={salon.map}>Otevřít v&nbsp;Mapách Google</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- úvod ---------- */
  .hero { padding-block: 40px 112px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 72px; align-items: center; }
  .hero__brow { width: min(100%, 560px); margin: 0 0 8px -6px; color: var(--cocoa); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__brow {
      -webkit-mask-image: linear-gradient(90deg, #000 42%, transparent 58%); mask-image: linear-gradient(90deg, #000 42%, transparent 58%);
      -webkit-mask-size: 280% 100%; mask-size: 280% 100%;
      -webkit-mask-position: 100% 0; mask-position: 100% 0;
      animation: powder 2.4s .15s cubic-bezier(.45, .05, .25, 1) forwards;
    }
  }
  @keyframes powder { to { -webkit-mask-position: 0 0; mask-position: 0 0; } }
  .hero__brow :global(svg) { width: 100%; height: auto; display: block; }
  h1 { font-size: var(--fs-hero); max-width: 13ch; }
  .hero__lead { font-size: var(--fs-md); line-height: 1.5; max-width: 34ch; margin: 28px 0 36px; color: var(--pigment); }
  .facts { display: flex; flex-wrap: wrap; gap: 20px 48px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); font-size: var(--fs-sm); }
  .facts dt { color: var(--pigment); }
  .facts dd a { text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }
  .hero__photo { position: relative; }
  .hero__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 60% 40%; border-radius: var(--r-img); }

  /* ---------- permanentní make-up ---------- */
  .pmu__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 40px 72px; }
  .pmu__head { align-self: start; position: sticky; top: 120px; }
  .pmu__head p { margin: 20px 0 24px; color: var(--pigment); max-width: 36ch; }
  .pmu__list { border-top: 1px solid var(--line); }
  .pmu__list li { border-bottom: 1px solid var(--line); }
  .pmu__list a { display: grid; grid-template-columns: 180px minmax(0, 1fr); grid-template-areas: "art name" "art text"; column-gap: 40px; align-items: center; padding: 36px 0; }
  .pmu__list :global(.pmu__art) { grid-area: art; width: 100%; height: auto; color: var(--cocoa); transition: transform var(--t) var(--ease); }
  .pmu__list :global(.stipple--lips) { color: var(--coral-deep); }
  .pmu__name { grid-area: name; align-self: end; font-size: var(--fs-xl); font-weight: 600; font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; line-height: 1.1; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 7px; transition: text-decoration-color var(--t-fast); }
  .pmu__text { grid-area: text; align-self: start; margin-top: 8px; color: var(--pigment); max-width: 48ch; }
  .pmu__list a:hover .pmu__name { text-decoration-color: var(--coral); }
  .pmu__list a:hover :global(.pmu__art) { transform: translateX(6px); }
  .pmu__fit { grid-column: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 40px; padding: 8px 0 0; }
  .pmu__fit h3 { grid-column: 1 / -1; font-size: var(--fs-md); font-variation-settings: 'opsz' 24; letter-spacing: 0; }
  .pmu__fit ul li { padding-left: 22px; position: relative; margin-bottom: 6px; }
  .pmu__fit ul li::before { content: ""; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
  .pmu__fit p { color: var(--pigment); }

  /* ---------- péče o pleť ---------- */
  .care { display: grid; grid-template-columns: minmax(0, 55fr) minmax(0, 45fr); background: var(--skin); }
  .care__photo :global(img) { width: 100%; height: 100%; min-height: 560px; object-fit: cover; object-position: 30% 50%; }
  .care__text { padding: 112px max(20px, calc((100vw - 1240px) / 2 + 20px)) 112px 72px; max-width: calc(560px + 92px); }
  .quote { margin: 32px 0; padding-left: 24px; border-left: 3px solid var(--coral); }
  .quote footer { margin-top: 12px; font-size: var(--fs-sm); color: var(--pigment); }
  .quote p { font-size: var(--fs-lg); line-height: 1.3; font-variation-settings: 'opsz' 48; letter-spacing: -0.01em; }
  .care__text > p { color: var(--pigment); }
  .care__list { margin: 28px 0 32px; border-top: 1px solid var(--line); }
  .care__list li { border-bottom: 1px solid var(--line); }
  .care__list a { display: block; padding: 14px 0; font-weight: 500; }
  .care__list a:hover { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 5px; }

  /* ---------- Karina ---------- */
  .karina { background: var(--cocoa); color: var(--on-cocoa); }
  .karina__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 80px; align-items: start; }
  .karina__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: var(--r-img); }
  .karina__role { margin: 12px 0 24px; color: var(--sand); }
  .karina__text > p:not(.karina__role) { color: var(--on-cocoa-muted); max-width: 52ch; }
  .timeline { list-style: none; margin: 36px 0; border-top: 1px solid rgba(244, 230, 217, .18); }
  .timeline li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(244, 230, 217, .18); }
  .timeline__y { color: var(--sand); font-variant-numeric: tabular-nums; font-weight: 600; }
  .timeline strong { font-weight: 600; color: var(--on-cocoa); }
  .timeline li span:last-child { color: var(--on-cocoa-muted); }
  .team { display: grid; gap: 10px; margin-bottom: 28px; color: var(--on-cocoa-muted); }
  .team strong { display: block; color: var(--on-cocoa); font-weight: 600; }
  .karina .txt-link { color: var(--on-cocoa); }

  /* ---------- další služby ---------- */
  .more__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 72px; }
  .more__list { margin-top: 36px; border-top: 1px solid var(--line); }
  .more__list li { border-bottom: 1px solid var(--line); }
  .more__list a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 24px; align-items: baseline; padding: 22px 0; }
  .more__name { font-size: var(--fs-lg); font-weight: 600; font-variation-settings: 'opsz' 48; letter-spacing: -0.015em; }
  .more__text { color: var(--pigment); }
  .more__list a:hover .more__name { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .more__side { display: grid; gap: 48px; align-content: start; padding-top: 12px; }
  .more__side h3 { font-size: var(--fs-md); font-variation-settings: 'opsz' 24; letter-spacing: 0; margin-bottom: 8px; }
  .more__side p { color: var(--pigment); margin-bottom: 12px; }

  /* ---------- studio ---------- */
  .studio__h { font-size: var(--fs-xl); margin-bottom: 32px; }
  .studio__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-auto-rows: clamp(220px, 28vw, 400px); gap: 16px; }
  .studio__grid :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: var(--r-img); }
  .studio__grid :global(.s1), .studio__grid :global(.s4) { grid-column: span 3; }
  .studio__grid :global(.s2), .studio__grid :global(.s3) { grid-column: span 2; }

  /* ---------- blog ---------- */
  .blog__grid > div { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .blog__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; margin-top: 48px; }
  .blog__list a { display: block; padding-top: 24px; border-top: 3px solid var(--cocoa); }
  .blog__list h3 { font-size: var(--fs-lg); letter-spacing: -0.015em; line-height: 1.15; font-variation-settings: 'opsz' 48; }
  .blog__list p { margin-top: 8px; color: var(--pigment); max-width: 60ch; }
  .blog__list a:hover h3 { text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 6px; }

  /* ---------- rezervace ---------- */
  .booking { background: var(--sand); }
  .book__motto { font-size: var(--fs-hero); font-weight: 600; font-variation-settings: 'opsz' 96; letter-spacing: -0.025em; line-height: 1.02; max-width: 14ch; margin-bottom: 80px; }
