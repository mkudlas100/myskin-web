---
import { Image, Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stipple from '../components/Stipple.astro';
import Booking from '../components/Booking.astro';
import { salon } from '../data/salon';
import { cz } from '../lib/cz';
import { salonNode, ownerNode } from '../lib/schema';

import logo from '../assets/img/logo.svg';
import cekarna from '../assets/img/salon-cekarna.jpg'; // jen pro strukturovaná data (skutečné studio)
// Ilustrační fotky z Unsplash (scripts/stock.json) – dočasně, než budou vlastní fotky.
import vyrez from '../assets/img/stock/uvod-vyrez.png';
import pece from '../assets/img/stock/k-pece-4.jpg';
import sklo from '../assets/img/stock/k-produkt-2.jpg';
import g1 from '../assets/img/stock/k-pece-9.jpg';
import g2 from '../assets/img/stock/k-produkt-4.jpg';
import g3 from '../assets/img/stock/k-oko-3.jpg';
import g4 from '../assets/img/stock/k-produkt-1.jpg';
import peekBrow from '../assets/img/stock/pmu-oboci.jpg';
import peekLips from '../assets/img/stock/pmu-rty.jpg';
import peekLiner from '../assets/img/stock/pmu-linky.jpg';

const title = 'Kosmetika a permanentní make-up Benešov | MySkin';
const description = 'Kosmetické studio MySkin v Benešově: permanentní make-up obočí, rtů a linek, ošetření pleti přírodní kosmetikou Phyt\'s a radiofrekvence. Rezervace online.';

const logoUrl = (await getImage({ src: logo, format: 'svg' })).src;
const salonImg = (await getImage({ src: cekarna, width: 1200, format: 'jpg' })).src;
const schema = [salonNode(new URL(logoUrl, Astro.site).href, new URL(salonImg, Astro.site).href), ownerNode()];

const pmu = [
  { shape: 'brow', peek: peekBrow, peekAlt: 'Detail upraveného obočí', href: '/permanentni-make-up-pudrove-oboci', name: 'Pudrové obočí', text: 'Stínované obočí s jemným přechodem od začátku ke konci. Doplní tvar, objem i hustotu, i když chloupky chybí.' },
  { shape: 'lips', peek: peekLips, peekAlt: 'Detail rtů v přirozeném odstínu', href: '/permanentni-make-up-stinovane-rty', name: 'Stínované rty', text: 'Sjednotí barvu a obrys rtů, takže vypadají upraveně i bez rtěnky.' },
  { shape: 'liner', peek: peekLiner, peekAlt: 'Oko s oční linkou', href: '/permanentni-make-up-ocni-linky', name: 'Oční linky', text: 'Linka v řasové linii, která se nerozmaže při sportu, v sauně ani v bazénu.' },
] as const;

const care = [
  { href: '/kosmeticke-osetreni', name: 'Kosmetické ošetření' },
  { href: '/pece-o-citlivou-plet', name: 'Péče o citlivou pleť' },
  { href: '/kura-chemicky-peeling', name: 'Chemický peeling' },
  { href: '/radiofrekvence', name: 'Radiofrekvence obličeje a těla' },
  { href: '/kompletni-osetreni-pro-muze', name: 'Ošetření pro muže' },
];

const timeline = [
  { y: '2005', t: 'Beauty & Art Academy', d: 'trvalé řasy a mikromasáž' },
  { y: '2007', t: 'Yves Rocher', d: 'kosmetička a poradkyně, osm let' },
  { y: '2011', t: 'Asklepion', d: 'kosmetička na klinice estetické medicíny' },
  { y: '2017', t: 'Asociace vizážistů a stylistů ČR', d: 'fotomakeup' },
  { y: '2021', t: 'Fleiš Academy', d: 'permanentní make-up' },
  { y: '2024', t: 'Fleiš Academy', d: 'pigmentologie a teorie barev' },
];

const more = [
  { href: '/rasy-oboci', name: 'Řasy a obočí', text: 'Lash lifting a laminace obočí' },
  { href: '/liceni', name: 'Líčení', text: 'Denní, plesové i svatební' },
  { href: '/depilace', name: 'Depilace', text: 'Teplým včelím voskem' },
];

// Pigment ve vzduchu kolem fotky v úvodu – pevně daná náhoda, ať se při buildu nemění.
let seed = 42;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const dust = Array.from({ length: 46 }, (_, i) => {
  const ring = rnd() < 0.7;
  const a = rnd() * Math.PI * 2;
  const r = ring ? 0.42 + rnd() * 0.12 : rnd() * 0.5;
  return {
    x: (50 + Math.cos(a) * r * 100).toFixed(1),
    y: (52 + Math.sin(a) * r * 92).toFixed(1),
    s: (2.5 + rnd() * 6.5).toFixed(1),
    c: i % 5 === 0 ? 'var(--coral)' : i % 3 === 0 ? 'var(--graphite)' : 'var(--ink)',
    o: (0.35 + rnd() * 0.6).toFixed(2),
    t: (9 + rnd() * 10).toFixed(1),
    d: (-rnd() * 18).toFixed(1),
    dx: ((rnd() - 0.5) * 36).toFixed(0),
    dy: ((rnd() - 0.5) * 36).toFixed(0),
  };
});

const posts = [
  { href: '/jak-se-pripravit-na-permanentni-make-up', title: 'Jak se připravit na permanentní make-up', text: 'Co dělat čtyři týdny, dva týdny i den před zákrokem a kdy je lepší ho odložit.' },
  { href: '/pudrove-oboci-den-po-dni', title: 'Pudrové obočí den po dni', text: 'Proč je obočí první dny tmavé, po týdnu skoro zmizí a pak se vrátí.' },
  { href: '/vse-co-potebujete-vedet-o-radiofrekvencni-peci', title: 'Radiofrekvence pleti: účinky a průběh', text: 'Jak radiofrekvence funguje, pro koho je vhodná a kolik sezení potřebujete.' },
];
---
<Base title={title} description={description} schema={schema}>

  <!-- Úvod: obočí z teček pigmentu, nadpis, portrét na pískovém tvaru -->
  <section class="hero" data-depth-root aria-labelledby="h-uvod">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <div class="hero__brow" data-depth="6"><Stipple shape="brow" /></div>
        <h1 id="h-uvod" class="split" style="--d: 250ms">Permanentní make-up a&nbsp;péče o&nbsp;pleť v&nbsp;Benešově</h1>
        <p class="hero__lead" data-reveal style="--i: 6">Jsem Karina Kudličková. Ve studiu na Pražské ulici dělám pudrové obočí, stínované rty a&nbsp;oční linky a&nbsp;pečuji o&nbsp;citlivou i&nbsp;problémovou pleť.</p>
        <div class="btns" data-reveal style="--i: 7">
          <a class="btn btn--primary" href={salon.booking}>Rezervovat termín</a>
          <a class="btn" href="/cenik">Ceník</a>
        </div>
        <dl class="facts" data-reveal style="--i: 8">
          <div><dt>Studio</dt><dd><a href={salon.map}>{salon.street}, Benešov</a></dd></div>
          <div><dt>Objednávky</dt><dd>Po–Pá, <a href={`tel:${salon.phoneHref}`}>{salon.phone}</a></dd></div>
        </dl>
      </div>
      <figure class="hero__visual">
        <div class="hero__blob">
          <div class="hero__dust hero__dust--back" data-depth="-8" aria-hidden="true">
            {dust.slice(0, 20).map((d) => <i style={`--x:${d.x}%;--y:${d.y}%;--s:${d.s}px;--c:${d.c};--o:${d.o};--t:${d.t}s;--d:${d.d}s;--dx:${d.dx}px;--dy:${d.dy}px`}></i>)}
          </div>
          <div class="hero__cut" data-depth="5">
            <Image src={vyrez} widths={[420, 640, 860, 1100, 1400]} sizes="(max-width: 860px) 90vw, 44vw" alt="Žena se zavřenýma očima, upraveným obočím a oční linkou" loading="eager" fetchpriority="high" />
          </div>
        </div>
        <div class="hero__dust hero__dust--front" data-depth="-20" aria-hidden="true">
          {dust.slice(20).map((d) => <i style={`--x:${d.x}%;--y:${d.y}%;--s:${d.s}px;--c:${d.c};--o:${d.o};--t:${d.t}s;--d:${d.d}s;--dx:${d.dx}px;--dy:${d.dy}px`}></i>)}
        </div>
      </figure>
    </div>
  </section>

  <!-- Permanentní make-up -->
  <section class="sec pmu" aria-labelledby="h-pmu">
    <div class="wrap pmu__grid">
      <div class="pmu__head">
        <h2 id="h-pmu" class="h2 split">Permanentní make-up</h2>
        <p data-reveal style="--i: 2">Pigment ukládám jemnými jehličkami do svrchní vrstvy pokožky. Cílem je přirozený výsledek, který ráno nemusíte dokreslovat.</p>
        <a class="txt-link" href="/permanentni-make-up" data-reveal style="--i: 3">Vše o&nbsp;permanentním make-upu</a>
      </div>
      <ul class="pmu__list peek-list">
        {pmu.map((p, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a href={p.href}>
              <Stipple shape={p.shape} class="pmu__art" amount={0.45} />
              <span class="pmu__name">{p.name}</span>
              <span class="pmu__text">{cz(p.text)}</span>
              <span class="pmu__peek" aria-hidden="true"><Image src={p.peek} widths={[320, 520]} sizes="260px" alt="" /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pmu__fit" data-reveal>
        <h3>Hodí se hlavně, když</h3>
        <ul>
          <li>máte alergii na běžnou dekorativní kosmetiku,</li>
          <li>se vám líčení rozmazává při sportu nebo v&nbsp;teple,</li>
          <li>chcete ráno ušetřit čas u&nbsp;zrcadla.</li>
        </ul>
        <p>Každému zákroku předchází konzultace, na které spolu probereme tvar a&nbsp;barvu.</p>
      </div>
    </div>
  </section>

  <!-- Péče o pleť -->
  <section class="care" aria-labelledby="h-care">
    <figure class="care__photo" data-reveal="clip">
      <Image src={pece} widths={[640, 960, 1280, 1600, 2000]} sizes="(max-width: 860px) 100vw, 55vw" alt="Nanášení pleťové masky štětcem" data-parallax="0.12" />
    </figure>
    <div class="care__text">
      <h2 id="h-care" class="h2 split">Péče o&nbsp;pleť</h2>
      <blockquote class="quote" data-reveal style="--i: 2">
        <p>„Vím, že pokožka dokáže říci o&nbsp;našem zdraví a&nbsp;kondici více, než si myslíme.“</p>
        <footer>Karina Kudličková</footer>
      </blockquote>
      <p data-reveal style="--i: 3">Nejčastěji pracuji s&nbsp;citlivou a&nbsp;problémovou pletí: s&nbsp;pigmentovými skvrnami, akné a&nbsp;růžovkou. Používám francouzskou BIO kosmetiku Phyt’s, kanadskou G.M.&nbsp;Collin a&nbsp;izraelskou NOON Aesthetics.</p>
      <ul class="care__list">
        {care.map((c, i) => <li data-reveal style={`--i: ${i + 4}`}><a href={c.href}>{c.name}</a></li>)}
      </ul>
      <a class="txt-link" href="/kosmeticke-sluzby" data-reveal style="--i: 9">Všechny kosmetické služby</a>
    </div>
  </section>

  <!-- Karina a tým -->
  <section class="sec karina" aria-labelledby="h-karina">
    <div class="wrap karina__grid">
      <figure class="karina__photo">
        <div class="karina__img" data-reveal="clip">
          <Image src={sklo} widths={[480, 720, 960, 1300]} sizes="(max-width: 860px) 100vw, 44vw" alt="Lahvička se sérem ve stínu listů" data-parallax="0.08" />
        </div>
        <figcaption>Ilustrační fotografie</figcaption>
      </figure>
      <div class="karina__text">
        <h2 id="h-karina" class="h2 split">Karina Kudličková</h2>
        <p class="karina__role" data-reveal style="--i: 2">Kosmetička a&nbsp;specialistka na permanentní make-up</p>
        <p data-reveal style="--i: 3">S&nbsp;kosmetikou pracuji přes patnáct let. Začínala jsem ve firmě Yves Rocher, prošla klinikou estetické medicíny a&nbsp;dnes se ve vlastním studiu věnuji hlavně permanentnímu make-upu a&nbsp;problematické pleti.</p>
        <ol class="timeline js-progress" aria-label="Vzdělání a praxe">
          {timeline.map((t, i) => <li data-reveal style={`--i: ${i}`}><span class="timeline__y">{t.y}</span><span><strong>{t.t}</strong> {cz(t.d)}</span></li>)}
        </ol>
        <div class="team" data-reveal>
          <p><strong>Michaela Benešová</strong> kosmetička a&nbsp;vizážistka, víc než deset let praxe</p>
        </div>
        <a class="txt-link" href="/o-mne" data-reveal style="--i: 1">Více o&nbsp;nás</a>
      </div>
    </div>
  </section>

  <!-- Další služby, kurzy, e-shop -->
  <section class="sec more" aria-labelledby="h-more">
    <div class="wrap more__grid">
      <div>
        <h2 id="h-more" class="h2 split">Další služby</h2>
        <ul class="more__list">
          {more.map((m, i) => <li data-reveal style={`--i: ${i}`}><a href={m.href}><span class="more__name">{m.name}</span><span class="more__text">{cz(m.text)}</span></a></li>)}
        </ul>
      </div>
      <div class="more__side">
        <div data-reveal style="--i: 2">
          <h3>Kurzy</h3>
          <p>Mini kurz líčení pro vás a&nbsp;refresh kurz pro kosmetičky.</p>
          <a class="txt-link" href="/kurzy-a-workshopy">Kurzy a&nbsp;workshopy</a>
        </div>
        <div data-reveal style="--i: 4">
          <h3>E-shop</h3>
          <p>Kosmetiku, se kterou pracuji ve studiu, si můžete objednat domů.</p>
          <a class="txt-link" href={salon.eshop}>Otevřít e-shop</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Atmosféra (ilustrační fotky) -->
  <section class="studio" aria-labelledby="h-studio">
    <div class="wrap">
      <div class="studio__head">
        <h2 id="h-studio" class="studio__h split">Klid a&nbsp;čas na péči</h2>
        <p class="studio__note">Ilustrační fotografie</p>
      </div>
      <div class="studio__grid">
        <div class="s1" data-reveal="clip" style="--i: 0"><Image src={g1} widths={[600, 900, 1300, 1800]} sizes="(max-width: 600px) 100vw, 58vw" alt="Klientka s čelenkou při ošetření obličeje" data-parallax="0.1" /></div>
        <div class="s2" data-reveal="clip" style="--i: 1"><Image src={g2} widths={[400, 700, 1000, 1300]} sizes="(max-width: 600px) 50vw, 38vw" alt="Vzorek krému na béžovém podkladu" data-parallax="0.1" /></div>
        <div class="s3" data-reveal="clip" style="--i: 0"><Image src={g3} widths={[400, 700, 1000, 1300]} sizes="(max-width: 600px) 50vw, 38vw" alt="Detail oka a obočí v teplém světle" data-parallax="0.1" /></div>
        <div class="s4" data-reveal="clip" style="--i: 1"><Image src={g4} widths={[600, 900, 1300, 1800]} sizes="(max-width: 600px) 100vw, 58vw" alt="Krém a sérum mezi květy a eukalyptem" data-parallax="0.1" /></div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="sec blog" aria-labelledby="h-blog">
    <div class="wrap blog__grid">
      <div>
        <h2 id="h-blog" class="h2 split">Z&nbsp;blogu</h2>
        <a class="txt-link" href="/blog-myskin">Všechny články</a>
      </div>
      <ul class="blog__list">
        {posts.map((p, i) => <li data-reveal style={`--i: ${i}`}><a href={p.href}><h3>{p.title}</h3><p>{cz(p.text)}</p></a></li>)}
      </ul>
    </div>
  </section>

  <Booking />
</Base>



<style>
  /* =========== úvod =========== */
  .hero { overflow-x: clip; padding-block: clamp(16px, 2vw, 48px) clamp(72px, 7vw, 160px); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(40px, 5vw, 120px); align-items: center; min-height: min(calc(100svh - 84px), 1100px); }
  .hero__brow { width: min(100%, clamp(300px, 34vw, 860px)); margin: 0 0 clamp(4px, .6vw, 16px) -.4%; color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__brow :global(svg) {
      -webkit-mask-image: linear-gradient(90deg, #000 42%, transparent 58%); mask-image: linear-gradient(90deg, #000 42%, transparent 58%);
      -webkit-mask-size: 280% 100%; mask-size: 280% 100%;
      -webkit-mask-position: 100% 0; mask-position: 100% 0;
      animation: powder 2.4s .1s cubic-bezier(.45, .05, .25, 1) forwards;
    }
  }
  @keyframes powder { to { -webkit-mask-position: 0 0; mask-position: 0 0; } }
  .hero__brow :global(svg) { width: 100%; height: auto; display: block; }
  h1 { font-size: var(--fs-hero); max-width: 13ch; }
  .hero__lead { font-size: var(--fs-md); line-height: 1.5; max-width: 34ch; margin: clamp(20px, 2vw, 44px) 0 clamp(28px, 2.6vw, 56px); color: var(--graphite); }
  .facts { display: flex; flex-wrap: wrap; gap: 20px clamp(32px, 4vw, 80px); margin-top: clamp(32px, 3.4vw, 72px); padding-top: 24px; border-top: 1px solid var(--line); font-size: var(--fs-sm); }
  .facts dt { color: var(--graphite); }
  .facts dd a { text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }

  .hero__visual { position: relative; aspect-ratio: 4 / 4.8; width: 100%; max-height: calc(100svh - 120px); justify-self: end; max-width: 860px; }
  .hero__blob { position: absolute; inset: 0; overflow: hidden; background: var(--sand); border-radius: 46% 54% 42% 58% / 52% 40% 60% 48%; }
  .hero__cut { position: absolute; left: 6%; right: -8%; bottom: 0; top: -2%; }
  .hero__cut :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 30% 0; }
  .hero__dust { position: absolute; inset: 0; pointer-events: none; }
  .hero__dust--front { inset: -6%; }
  .hero__dust i { position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); border-radius: 50%; background: var(--c); opacity: var(--o); }

  /* =========== permanentní make-up =========== */
  .pmu__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 40px clamp(40px, 5vw, 120px); }
  .pmu__head { align-self: start; position: sticky; top: 120px; }
  .pmu__head p { margin: 20px 0 24px; color: var(--graphite); max-width: 36ch; }
  .pmu__list { border-top: 1px solid var(--line); }
  .pmu__list li { border-bottom: 1px solid var(--line); }
  .pmu__list a { display: grid; grid-template-columns: clamp(96px, 13vw, 300px) minmax(0, 1fr); grid-template-areas: "art name" "art text"; column-gap: clamp(20px, 3vw, 64px); align-items: center; padding: clamp(24px, 2.6vw, 52px) 0; }
  .pmu__list :global(.pmu__art) { grid-area: art; width: 100%; height: auto; color: var(--ink); transition: transform var(--t) var(--ease); }
  .pmu__list :global(.stipple--lips) { color: var(--coral-deep); }
  .pmu__name { grid-area: name; align-self: end; font-size: var(--fs-xl); font-weight: 600; font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; line-height: 1.1; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 7px; transition: text-decoration-color var(--t-fast); }
  .pmu__text { grid-area: text; align-self: start; margin-top: 8px; color: var(--graphite); max-width: 48ch; }
  .pmu__list a:hover .pmu__name { text-decoration-color: var(--coral); }
  .pmu__list a:hover :global(.pmu__art) { transform: translateX(8px) scale(1.04); }
  .pmu__list li { position: relative; }
  .pmu__peek { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .pmu__peek { display: block; position: absolute; left: var(--mx, 50%); top: var(--my, 50%); width: clamp(180px, 14vw, 300px); aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--r-img); pointer-events: none; z-index: 3; box-shadow: var(--sh-2); opacity: 0; transform: translate(36px, -50%) rotate(-5deg) scale(.7); transition: opacity .35s var(--ease), transform .6s var(--ease-out); }
    .pmu__peek :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .pmu__list a:hover .pmu__peek { opacity: 1; transform: translate(36px, -50%) rotate(-3deg) scale(1); }
  }
  .pmu__fit { grid-column: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 40px; }
  .pmu__fit h3 { grid-column: 1 / -1; font-size: var(--fs-md); font-variation-settings: 'opsz' 24; letter-spacing: 0; }
  .pmu__fit ul li { padding-left: 22px; position: relative; margin-bottom: 6px; }
  .pmu__fit ul li::before { content: ""; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
  .pmu__fit p { color: var(--graphite); }

  /* =========== péče o pleť =========== */
  .care { display: grid; grid-template-columns: minmax(0, 55fr) minmax(0, 45fr); background: var(--mist-light); }
  .care__photo { overflow: hidden; }
  .care__photo :global(img) { width: 100%; height: 100%; min-height: clamp(560px, 50vw, 1200px); object-fit: cover; object-position: 50% 72%; }
  .care__text { padding: var(--sec) max(var(--pad), calc((100vw - 1680px) / 2)) var(--sec) clamp(40px, 5vw, 120px); }
  .care__text > * { max-width: 40rem; }
  .quote { margin: clamp(24px, 2.4vw, 48px) 0; padding-left: 24px; border-left: 3px solid var(--coral); }
  .quote p { font-size: var(--fs-lg); line-height: 1.3; font-variation-settings: 'opsz' 48; letter-spacing: -0.01em; }
  .quote footer { margin-top: 12px; font-size: var(--fs-sm); color: var(--graphite); }
