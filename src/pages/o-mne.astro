---
// O nás: příběh Kariny, specializace, certifikáty a tým. Fakta jen ze stávajícího webu.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceList from '../components/ServiceList.astro';
import Booking from '../components/Booking.astro';
import { allServices, pick } from '../lib/content';
import { breadcrumbNode, ids } from '../lib/schema';
import { salon } from '../data/salon';
import { cz } from '../lib/cz';
import karinaPostava from '../assets/img/foto/karina-postava.jpg';
import karinaPortret from '../assets/img/foto/karina-portret.jpg';
import karinaPrace from '../assets/img/foto/karina-pri-praci.jpg';
import michaela from '../assets/img/foto/michaela-benesova.jpg';

const url = `${salon.url}/o-mne`;
const crumbs = [{ name: 'Úvod', href: '/' }, { name: 'O nás', href: '/o-mne' }];
const services = pick(await allServices(), ['permanentni-make-up', 'kosmeticke-osetreni', 'radiofrekvence', 'kura-chemicky-peeling'], 'o-mne');

const cesta = [
  { y: '2005', t: 'Beauty & Art Academy', d: 'Trvalá na řasy, mikromasáž očního okolí, modeláž nehtů gelem.' },
  { y: '2007–2015', t: 'Yves Rocher', d: 'Kosmetička a kosmetická poradkyně. Aromatické a tradiční tělové péče, kosmetická ošetření.' },
  { y: '2011–2012', t: 'Klinika Asklepion', d: 'Kosmetička na klinice estetické medicíny. Školení: kosmetická radiofrekvence, tělový přístroj LPG, lymfodrenáž, kryolipolýza.' },
  { y: '2017', t: 'Asociace vizážistů a stylistů ČR', d: 'Fotomakeup a make-up na kameru.' },
  { y: '2021', t: 'Permanentní make-up', d: 'Kurz aplikace, designu a korekcí permanentního make-upu.' },
  { y: '2024', t: 'Fleiš Academy', d: 'Pigmentologie a teorie barev – složení pigmentů a míchání odstínů.' },
];

const pleti = ['hyperpigmentace', 'těžká aknózní pleť', 'růžovka', 'citlivá pleť'];

const imgUrl = new URL((await getImage({ src: karinaPostava, width: 1200, format: 'jpg' })).src, Astro.site).href;
const schema = [
  breadcrumbNode(url, crumbs),
  {
    '@type': 'Person',
    '@id': ids.owner,
    name: salon.owner.name,
    jobTitle: salon.owner.jobTitle,
    worksFor: { '@id': ids.salon },
    url,
    knowsAbout: ['Permanentní make-up', 'Pudrové obočí', 'Stínované rty', 'Oční linky', 'Péče o citlivou a problematickou pleť', 'Radiofrekvence', 'Chemický peeling'],
    hasCredential: cesta.filter((c) => !c.y.includes('–')).map((c) => ({ '@type': 'EducationalOccupationalCredential', name: `${c.t} – ${c.d}`, dateCreated: c.y })),
    alumniOf: [{ '@type': 'Organization', name: 'Beauty & Art Academy' }, { '@type': 'Organization', name: 'Fleiš Academy' }],
  },
  {
    '@type': 'Person',
    '@id': `${salon.url}/#michaela`,
    name: 'Michaela Benešová',
    jobTitle: 'Kosmetička a vizážistka',
    worksFor: { '@id': ids.salon },
  },
];
---
<Base title="Karina Kudličková – kosmetička Benešov | O nás | MySkin" description="Karina Kudličková, kosmetička a specialistka na permanentní make-up: přes 15 let praxe, Yves Rocher, klinika Asklepion, pigmentologie. Studio MySkin Benešov." schema={schema} pageType="AboutPage" ogImage={karinaPortret}>
  <PageHero crumbs={crumbs} h1="Z kliniky zpět k lidem" perex="Jsem Karina Kudličková, kosmetička a specialistka na permanentní make-up. Po letech ve velké kosmetické firmě a na klinice estetické medicíny pečuji ve vlastním studiu v Benešově o pleť a dělám pudrové obočí, stínované rty a oční linky." image={karinaPostava} imageAlt="Karina Kudličková ve studiu MySkin" shape="frame" secondary={{ label: 'Kontakt', href: '/kontakt' }} />

  <section class="sec story">
    <div class="wrap story__grid">
      <figure class="story__photo" data-reveal="clip"><Image src={karinaPrace} widths={[400, 700, 1000]} sizes="(max-width: 860px) 92vw, 34vw" alt="Karina Kudličková při permanentním make-upu" /></figure>
      <div class="prose">
        <h2>Můj příběh</h2>
        <p>{cz('Více než deset let jsem sbírala zkušenosti v prestižní mezinárodní kosmetické firmě a na klinice estetické medicíny. Pak jsem se rozhodla vykročit vlastní cestou a založila studio, které stojí na síle přírodních ingrediencí a hluboké péči o pleť.')}</p>
        <p>{cz('S počtem klientek rostla i jejich přání – od klasické kosmetiky přes luxusní ošetření, chemické peelingy a řešení problematické pleti až po líčení na svatbu. Když bylo jasné, že všechno nezvládnu sama na nejvyšší úrovni, sestavila jsem tým. Neděláme všechno. Děláme to, co umíme nejlépe.')}</p>
        <h2>Na co se specializuji</h2>
        <p>{cz('Věnuji se individuální péči o citlivou a problematickou pleť:')}</p>
        <ul>{pleti.map((p) => <li>{p}</li>)}</ul>
        <p>Mou vášní je <a href="/permanentni-make-up">permanentní make-up</a> – precizní <a href="/permanentni-make-up-pudrove-oboci">pudrové obočí</a>, <a href="/permanentni-make-up-ocni-linky">oční linky</a> a <a href="/permanentni-make-up-stinovane-rty">stínované rty</a>. {cz('Zkušenosti jsem sbírala i na mezinárodní soutěži v Bratislavě a dál se vzdělávám na pokročilých kurzech.')}</p>
        <blockquote><p>{cz('Krása je vždy v jedinečnosti. Mým posláním je vcítit se do potřeb klientek a najít způsob, jak odemknout jejich jedinečnou krásu. Pokožka toho o našem zdraví a kondici řekne víc, než si myslíme.')}</p></blockquote>
      </div>
    </div>
  </section>

  <section class="sec path js-progress" aria-labelledby="h-cesta">
    <div class="wrap path__grid">
      <div class="path__head">
        <h2 id="h-cesta" class="h2 split">Vzdělání a praxe</h2>
        <p data-reveal style="--i: 2">{cz('Přes patnáct let v oboru – od kosmetických škol přes kliniku estetické medicíny po pigmentologii.')}</p>
      </div>
      <ol class="path__list">
        {cesta.map((c, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <span class="path__y">{c.y}</span>
            <div><h3>{c.t}</h3><p>{cz(c.d)}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec team" aria-labelledby="h-tym">
    <div class="wrap">
      <h2 id="h-tym" class="h2 split">Tým MySkin</h2>
      <div class="team__grid">
        <article class="member" data-reveal>
          <figure class="member__img" data-reveal="clip"><Image src={karinaPortret} widths={[400, 700, 1000]} sizes="(max-width: 860px) 92vw, 40vw" alt="Karina Kudličková, kosmetička a specialistka na permanentní make-up" /></figure>
          <h3>Karina Kudličková</h3>
          <p class="member__role">Kosmetička a specialistka na permanentní make-up</p>
          <p>Dělám <a href="/permanentni-make-up">permanentní make-up</a> – pudrové obočí, stínované rty a oční linky – a {cz('pečuji o citlivou a problematickou pleť: hyperpigmentace, akné i růžovku.')}</p>
        </article>
        <article class="member" data-reveal style="--i: 1">
          <figure class="member__img" data-reveal="clip"><Image src={michaela} widths={[400, 700, 1000]} sizes="(max-width: 860px) 92vw, 40vw" alt="Michaela Benešová, kosmetička a vizážistka" /></figure>
          <h3>Michaela Benešová</h3>
          <p class="member__role">Kosmetička a vizážistka</p>
          <p>{cz('Vystudovala v Praze obor kosmetika a vizážistika a má za sebou víc než deset let praxe. Znám ji dlouho a vždy jsem se na ni mohla spolehnout.')} Specializuje se na komplexní <a href="/kosmeticke-osetreni">kosmetická ošetření</a>, relaxační procedury a šetrnou <a href="/depilace">depilaci</a>. {cz('Její laskavost a smysl pro humor promění každou návštěvu v příjemný zážitek.')}</p>
        </article>
      </div>
    </div>
  </section>

  <ServiceList services={services} heading="S čím vám pomůžu" id="sluzby" />
  <Booking />
</Base>
<style>
  .story__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 140px); align-items: start; }
  .story__photo { border-radius: var(--r-img); overflow: hidden; aspect-ratio: 4 / 5; background: var(--mist-light); position: sticky; top: 130px; }
  .story__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .story .prose { max-width: 68ch; }
  .path { background: var(--mist-light); }
  .path__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 32px clamp(40px, 6vw, 140px); }
  .path__head p { margin-top: 20px; color: var(--graphite); max-width: 38ch; }
  .path__list { border-top: 1px solid var(--line); }
  .path__list li { display: grid; grid-template-columns: clamp(96px, 9vw, 160px) minmax(0, 1fr); gap: 20px; padding: clamp(20px, 1.8vw, 32px) 0; border-bottom: 1px solid var(--line); }
  .path__y { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--graphite); transition: color var(--t); }
  .path__list li.on .path__y { color: var(--coral-deep); }
  .path__list h3 { font-size: var(--fs-lg); font-variation-settings: 'opsz' 48; letter-spacing: -0.015em; line-height: 1.2; }
  .path__list p { color: var(--graphite); margin-top: 6px; max-width: 60ch; }
  .team h2 { margin-bottom: clamp(28px, 3vw, 64px); }
  .team__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 4vw, 96px); }
  .member__img { border-radius: var(--r-img); overflow: hidden; aspect-ratio: 4 / 5; background: var(--mist-light); margin-bottom: 22px; }
  .member__img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .member h3 { font-size: var(--fs-lg); font-variation-settings: 'opsz' 48; letter-spacing: -0.015em; }
  .member__role { font-weight: 600; color: var(--graphite); margin: 6px 0 14px; }
  .member p:not(.member__role) { color: var(--graphite); max-width: 56ch; }
  .member a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .story__grid, .path__grid, .team__grid { grid-template-columns: minmax(0, 1fr); }
    .story__photo { position: static; max-width: 420px; }
  }
</style>
