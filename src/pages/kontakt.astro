---
// Kontakt: plné údaje salonu (BeautySalon), mapa, rezervace. Údaje jen ze src/data/salon.ts.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import { breadcrumbNode, salonNode, ownerNode } from '../lib/schema';
import { salon } from '../data/salon';
import logo from '../assets/img/logo.svg';
import cekarna from '../assets/img/salon-cekarna.jpg';
import lehatko from '../assets/img/salon-lehatko.jpg';
import mapa from '../assets/img/mapa.jpg';

const url = `${salon.url}/kontakt`;
const crumbs = [{ name: 'Úvod', href: '/' }, { name: 'Kontakt', href: '/kontakt' }];
const logoUrl = new URL((await getImage({ src: logo, format: 'svg' })).src, Astro.site).href;
const salonImg = new URL((await getImage({ src: cekarna, width: 1200, format: 'jpg' })).src, Astro.site).href;
const faq = [
  { q: 'Jak se objednám?', a: `Nejrychleji online přes rezervační systém Noona, kde vidíte volné termíny. Můžete také zavolat na ${salon.phone} nebo napsat na ${salon.email}.` },
  { q: 'Jaká je otevírací doba?', a: 'Pracuji na objednání. Volné termíny najdete v online rezervaci.' },
  { q: 'Kde studio najdu?', a: `Na adrese ${salon.street}, ${salon.postalCode} ${salon.city}.` },
];
const schema = [
  salonNode(logoUrl, salonImg),
  ownerNode(),
  breadcrumbNode(url, crumbs),
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Kontakt a online rezervace | Kosmetika MySkin Benešov" description={`Kosmetické studio MySkin, ${salon.street}, Benešov. Objednejte se online přes Noona nebo na tel. ${salon.phone}. Permanentní make-up, kosmetika, řasy a obočí.`} schema={schema} pageType="ContactPage" ogImage={lehatko}>
  <PageHero crumbs={crumbs} h1="Kontakt" perex="Těším se na vás ve studiu v Benešově. Termín si nejrychleji rezervujete online – hned uvidíte, kdy mám volno." image={lehatko} imageAlt="Ošetřovna studia MySkin v Benešově" shape="frame" secondary={{ label: 'Ceník', href: '/cenik' }} />

  <section class="sec nap">
    <div class="wrap nap__grid">
      <address class="nap__card" data-reveal>
        <p class="nap__name">{salon.name}</p>
        <dl>
          <div><dt>Adresa</dt><dd><a href={salon.map}>{salon.street}<br />{salon.postalCode} {salon.city}</a></dd></div>
          <div><dt>Telefon</dt><dd><a href={`tel:${salon.phoneHref}`}>{salon.phone}</a></dd></div>
          <div><dt>E-mail</dt><dd><a href={`mailto:${salon.email}`}>{salon.email}</a></dd></div>
          <div><dt>Otevřeno</dt><dd>{salon.hours}</dd></div>
          <div><dt>Provozovatel</dt><dd>{salon.operator}, IČO {salon.ico}</dd></div>
        </dl>
        <div class="btns">
          <a class="btn btn--primary" href={salon.booking}>Rezervovat online</a>
          <a class="btn" href={`tel:${salon.phoneHref}`}>Zavolat</a>
        </div>
        <ul class="nap__social">
          <li><a href={salon.social.instagram}>Instagram</a></li>
          <li><a href={salon.social.facebook}>Facebook</a></li>
          <li><a href={salon.eshop}>E-shop</a></li>
        </ul>
      </address>
      <a class="nap__map" href={salon.map} data-reveal="clip" aria-label="Otevřít mapu v Google Maps">
        <Image src={mapa} widths={[480, 800, 1200, 1600]} sizes="(max-width: 860px) 92vw, 55vw" alt={`Mapa: ${salon.street}, Benešov`} />
        <span class="nap__pin">Otevřít v Mapách Google</span>
      </a>
    </div>
  </section>
  <Faq items={faq} />
  <Booking />
</Base>
<style>
  .nap__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 4vw, 96px); align-items: stretch; }
  .nap__card { font-style: normal; padding: clamp(28px, 3vw, 64px); background: var(--mist-light); border-radius: var(--r-img); display: flex; flex-direction: column; gap: 28px; }
  .nap__name { font-size: var(--fs-lg); font-weight: 600; font-variation-settings: 'opsz' 48; }
  .nap__card dl { display: grid; gap: 16px; }
  .nap__card dl div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .nap__card dt { color: var(--graphite); font-size: var(--fs-sm); padding-top: 2px; }
  .nap__card dd { font-weight: 600; }
  .nap__card dd a { text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }
  .nap__social { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .nap__social a { font-weight: 600; text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 4px; }
  .nap__map { position: relative; display: block; border-radius: var(--r-img); overflow: hidden; min-height: 360px; background: var(--mist-light); }
  .nap__map :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .nap__map:hover :global(img) { transform: scale(1.03); }
  .nap__pin { position: absolute; left: 20px; bottom: 20px; background: var(--ink); color: var(--on-ink); padding: 12px 18px; border-radius: 999px; font-size: var(--fs-sm); font-weight: 600; }
  @media (max-width: 860px) { .nap__grid { grid-template-columns: minmax(0, 1fr); } .nap__card dl div { grid-template-columns: 96px minmax(0, 1fr); } }
</style>
