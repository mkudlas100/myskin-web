{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pedikura",
      "destination": "/kosmeticke-sluzby",
      "permanent": true
    },
    {
      "source": "/pedikura-2",
      "destination": "/kosmeticke-sluzby",
      "permanent": true
    },
    {
      "source": "/bricho-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/hyzde-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/paze-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/stehna-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/jak-pecovat-o-pmu",
      "destination": "/jak-pecovat-o-permanentni-make-up",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}