{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/pedikura",
      "destination": "/kosmeticke-sluzby",
      "permanent": true
    },
    {
      "source": "/pedikura-2",
      "destination": "/kosmeticke-sluzby",
      "permanent": true
    },
    {
      "source": "/bricho-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/hyzde-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/paze-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/stehna-radiofrekvencni-pece",
      "destination": "/radiofrekvence",
      "permanent": true
    },
    {
      "source": "/jak-pecovat-o-pmu",
      "destination": "/jak-pecovat-o-permanentni-make-up",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}